#include "totvs.ch"
#include "fwmvcdef.ch"
#include "custom.orc.th"

namespace custom.orc.utils

/*/{Protheus.doc} ModelActivate
	Ponto de ativacao do Model (SetActivate) do cadastro de Áreas (ZB1).
	Executado ao ativar o formulario; na operacao de INCLUIR, gera o
	codigo sequencial do produto (ZB1_COD) via GetSXENum, garantindo que
	o codigo nao esteja em uso (checagem via CodExiste) antes de
	gravar o valor no Model.

	@type user function

	@author igor.seberino

	@since 22/10/2026

	@param oModel

	@see ZA1CodExiste
/*/
User Function ModelActivate( oModel as object, cAlias as character )

	Local cCodigo
	Local cCodField := cAlias + "_COD"
	Local cModel := cAlias + "MASTER"

	If oModel:GetOperation() == MODEL_OPERATION_INSERT

		cCodigo := GetSXENum( cAlias, cCodField )

		Do While U_CodExiste(cCodigo, cAlias)

			cCodigo := GetSXENum( cAlias, cCodField )

		EndDo

		oModel:SetValue( cModel, cCodField, cCodigo )

	EndIf

Return

/*/{Protheus.doc} CodExiste
	Verifica se ja existe produto (nao deletado) com o codigo
	informado.

	@type user function

	@author igor.seberino

	@since 22/10/2026

	@param cCod, character

	@return logical, .T.=Existe, .F.=Nao Existe
/*/
User Function CodExiste( cCod as character, cAlias as character )

	Local lExiste := .F.
	Local cCodField := cAlias + '_COD'
	Local cCodFieldSearch := cAlias + "." + cCodField + " = "

	Local cQuery := U_QuerySet( cAlias, { cCodField }, { { cCodFieldSearch, cCod } } )

	Local cAliasQry := MPSysOpenQuery(cQuery)

	lExiste := !(cAliasQry)->(EoF())

	(cAliasQry)->(dbCloseArea())

Return lExiste

/*/{Protheus.doc} QuerySet
	Monta uma query de acordo com os parametros passados.
    Protegida contra SQL Injection com FWPreparedStatement

	@type user function

	@author igor.seberino

	@since 22/10/2026

	@param cAlias, character
    
    @param aParamsSelect, array, parametros que deseja como retorno

    @param aParamsWhere, array, parametros que deseja filtrar,
    formato { {Campo + Operador, Valor} }
    exemplo { { "ZA1.ZA1_COD = ", "000004" } }

	@return cQueryRet, query montada
/*/
User Function QuerySet( cAlias as character, aParamsSelect as array, aParamsWhere as array )

	Local oStmt := FWPreparedStatement():New()
	Local cQueryBase as character
	Local cQueryRet as character
	Local nI as integer

	// Começa a montar a query
	cQueryBase := " SELECT "

	// Adiciona parâmetros conforme passado
	// no array, de forma dinâmica
	For nI := 1 to Len(aParamsSelect)
		If nI != 1
			cQueryBase += ", "
		EndIf
		cQueryBase += aParamsSelect[nI]
	Next nI

	// Adição dinâmica de table
	cQueryBase += " FROM " + RetSQLName(cAlias) + " " +  cAlias

	// Adiciona parâmetros conforme passado
	// no array, de forma dinâmica
	If Len(aParamsWhere) > 0
		For nI := 1 to Len(aParamsWhere)
			If nI == 1
				cQueryBase += " WHERE " + cAlias + ".D_E_L_E_T_ = ' ' "
				cQueryBase += " AND " + cAlias + "_FILIAL = ? "
				cQueryBase += " AND " + aParamsWhere[nI][1] + " ? "
			Else
				cQueryBase += " AND " + aParamsWhere[nI][1] + " ? "
			EndIf
		Next nI
		// Garante o filtro de itens deletados
		// mesmo sem parâmetros de busca
	Else
		cQueryBase += " WHERE " + cAlias + ".D_E_L_E_T_ = ' ' "
		cQueryBase += " AND " + cAlias + "_FILIAL = ? "
	EndIf

	oStmt:SetQuery(cQueryBase)

	oStmt:SetString(1, xFilial(cAlias))

	// Preenchimento dinâmico dos parâmetros
	// de busca
	For nI := 1 to Len(aParamsWhere)

		If ValType(aParamsWhere[nI][2]) == "C"

			oStmt:SetString(nI + 1, aParamsWhere[nI][2])

		ElseIf ValType(aParamsWhere[nI][2]) == "N"

			oStmt:SetNumeric(nI + 1, aParamsWhere[nI][2])

		ElseIf ValType(aParamsWhere[nI][2]) == "D"

			oStmt:SetDate(nI + 1, aParamsWhere[nI][2])

		ElseIf ValType(aParamsWhere[nI][2]) == "L"

			oStmt:SetLogical(nI + 1, aParamsWhere[nI][2])

		EndIf

	Next nI

	cQueryRet := oStmt:GetFixQuery()

Return cQueryRet

/*/{Protheus.doc} HoursToNum
	Converte texto hh:mm em horas decimais. Ex.: "08:30" -> 8.5

	@type user function

	@author igor.seberino

	@since 27/10/2026

	@return numeric
/*/
User Function HoursToNum( cHour as character ) as numeric

	Local nPos as numeric
	Local nHH  as numeric
	Local nMM  as numeric

	cHour := StrTran( AllTrim( cHour ), ".", "" )
	nPos  := At( ":", cHour )

	If nPos == 0
		// Sem ":" = horas inteiras ("8" = 8:00)
		nHH := Val( cHour )
		nMM := 0
	Else
		nHH := Val( Left( cHour, nPos - 1 ) )
		nMM := Val( SubStr( cHour, nPos + 1 ) )
	EndIf

Return Round( nHH + ( nMM / 60 ), 2 )

/*/{Protheus.doc} NumToHours
	Converte horas decimais em texto

	@type user function

	@author igor.seberino

	@since 27/10/2026

	@return logical
/*/
User Function NumToHours( nValue as numeric )

	Local nMinutos := Round( nValue * 60, 0 )        // arredonda o total em minutos
	Local nHH      := Int( nMinutos / 60 )
	Local nMM      := nMinutos % 60
	Local cHH      := AllTrim( Transform( nHH, "@E 999,999,999" ) )

Return cHH + ":" + StrZero( nMM, 2 )

/*/{Protheus.doc} TotalHrsCharSet
	Habilita a edição do campo de total de horas, 
    insere o valor e desabilita de novo

	@type user function

	@author igor.seberino

	@since 03/11/2026
/*/
User Function TotalHrsCharSet( nTotal as numeric, cModel as character ) as logical

	Local oModel := FWModelActive()
	Local cAlias := Left( cModel, 3 )
	Local cPai   as character

	oModel:GetModel( cModel ):LoadValue( cAlias + "_TOTHR", U_NumToHours( nTotal ) )

	Do Case
	Case cModel == "ZB6DETAIL"
		cPai := "ZB5DETAIL"
	Case cModel == "ZB5DETAIL"
		cPai := "ZB4MASTER"
	Otherwise
		cPai := ""
	EndCase

	If !Empty( cPai )
		U_CalcHrsRows( cModel, cAlias + "_TTHRNM", cPai, Left( cPai, 3 ) + "_TTHRNM" )
	EndIf

Return .T.

/*/{Protheus.doc} OnHrDayChange
	Recalcula todas as atividades e todos os itens
    na alteração do Hrs/Dia, a partir do novo valor. 
    Demais gatilhos e atualizações partem dos campos
    alterados aqui

	@type user function

	@author igor.seberino

	@since 03/11/2026
/*/
User Function OnHrDayChange( nHrDia as numeric )

	Local oModel    := FWModelActive()
	Local oModelZB5 as object
	Local oModelZB6 as object
	Local n1 as numeric
	Local n2 as numeric
	Local aSaveRows as array
	Local nDoc as numeric
	Local nDev as numeric
	Local nAna as numeric
	Local nVal as numeric
	Local nOpcao as numeric

	// Verifica se já foram calculadas as horas de algo (necessário recalcular)
	If M->ZB4_TTHRNM > 0

		// Salva a linha que estava posicionada de cada model
		aSaveRows := FWSaveRows()

		If !IsBlind()
			nOpcao := Aviso( "Horas/Dia alterado", "Já existem horas lançadas, como deseja recalcular?", { "Recalc. Horas", "Recalc. Dias" } )
		Else
			nOpcao := 1 // Recalcula horas por default
		EndIf

		oModelZB5 := oModel:GetModel("ZB5DETAIL")
		oModelZB6 := oModel:GetModel("ZB6DETAIL")

		If nOpcao == 1
			// Valida os dias novamente

			// Percorre cada item do orçamento
			For n1 := 1 to oModelZB5:Length()

				If !oModelZB5:IsDeleted(n1)

					oModelZB5:GoLine(n1)

					// Percorre cada atividade do item
					For n2 := 1 to oModelZB6:Length()

						If !oModelZB6:IsDeleted(n2)

							oModelZB6:GoLine(n2)

							// Grava recalculado em cada campo
							nDoc := oModelZB6:GetValue("ZB6_DDOC") * nHrDia
							nDev := oModelZB6:GetValue("ZB6_DDEV") * nHrDia
							nAna := oModelZB6:GetValue("ZB6_DANA") * nHrDia
							nVal := oModelZB6:GetValue("ZB6_DVAL") * nHrDia

							oModelZB6:SetValue( "ZB6_HDOC", U_NumToHours(nDoc) )
							oModelZB6:SetValue( "ZB6_HDEV", U_NumToHours(nDev) )
							oModelZB6:SetValue( "ZB6_HANA", U_NumToHours(nAna) )
							oModelZB6:SetValue( "ZB6_HVAL", U_NumToHours(nVal) )

						EndIf

					Next n2

				EndIf

			Next n1

		Else
			// Valida as horas novamente

			// Percorre cada item do orçamento
			For n1 := 1 to oModelZB5:Length()

				If !oModelZB5:IsDeleted(n1)

					oModelZB5:GoLine(n1)

					// Percorre cada atividade do item
					For n2 := 1 to oModelZB6:Length()

						If !oModelZB6:IsDeleted(n2)

							oModelZB6:GoLine(n2)

							// Grava recalculado em cada campo
							nDoc := oModelZB6:GetValue("ZB6_HDOCNM") / nHrDia
							nDev := oModelZB6:GetValue("ZB6_HDEVNM") / nHrDia
							nAna := oModelZB6:GetValue("ZB6_HANANM") / nHrDia
							nVal := oModelZB6:GetValue("ZB6_HVALNM") / nHrDia

							oModelZB6:SetValue( "ZB6_DDOC", nDoc )
							oModelZB6:SetValue( "ZB6_DDEV", nDev )
							oModelZB6:SetValue( "ZB6_DANA", nAna )
							oModelZB6:SetValue( "ZB6_DVAL", nVal )

						EndIf

					Next n2

				EndIf

			Next n1

		EndIf

		// Retorna às linhas originais
		FWRestRows( aSaveRows )

	EndIf

Return .T.

/*/{Protheus.doc} VldDefin
	Valida definição caso seja escrita pelo usuário,
    verificando se está ativa ou existe. 

	@type user function

	@author igor.seberino

	@since 03/11/2026

    @return logical
/*/
User Function VldDefin( cDefin as character )

	Local cQuery := U_QuerySet( "ZB2", {"ZB2_COD"}, {{"ZB2.ZB2_COD = ", cDefin}, {"ZB2.ZB2_ATIVO = ", ATIVO_SIM}} )
	Local cAliasQry := MPSysOpenQuery(cQuery)
	Local lRet := .T.

	If (cAliasQry)->(EoF())
		Help( , , " HELP", , "Definição não existe ou está inativa", 1, 0 )
		lRet := .F.
	EndIf

	(cAliasQry)->(dbCloseArea())

Return lRet

/*/{Protheus.doc} VldArea
	Valida área caso seja escrita pelo usuário,
    verificando se está ativa ou existe. 

	@type user function

	@author igor.seberino

	@since 03/11/2026

    @return logical
/*/
User Function VldArea( cArea as character )

	Local cQuery := U_QuerySet( "ZB1", {"ZB1_COD"}, {{"ZB1.ZB1_COD = ", cArea}, {"ZB1.ZB1_ATIVO = ", ATIVO_SIM}} )
	Local cAliasQry := MPSysOpenQuery(cQuery)
	Local lRet := .T.

	If (cAliasQry)->(EoF())
		Help( , , " HELP", , "Área não existe ou está inativa", 1, 0 )
		lRet := .F.
	EndIf

	(cAliasQry)->(dbCloseArea())

Return lRet

/*/{Protheus.doc} VldAprov
	Valida se o usuário existe e se
    já está cadastrado como aprovador

	@type user function

	@author igor.seberino

	@since 03/11/2026

    @return logical
/*/
User Function VldAprov( cUser as character )

	Local cQuery := U_QuerySet( "ZB3", {"ZB3_USER"}, {{"ZB3.ZB3_USER = ", cUser}} )
	Local cAliasQry := MPSysOpenQuery(cQuery)
	Local lRet := .T.

	If !UsrExist(cUser)
		Help( , , " HELP", , "Usuário não existe", 1, 0 )
		lRet := .F.
	ElseIf !(cAliasQry)->(EoF())
		Help( , , " HELP", , "Aprovador já cadastrado", 1, 0 )
		lRet := .F.
	EndIf

	(cAliasQry)->(dbCloseArea())

Return lRet

User Function VldHours( cHour as character )

	Local nPos as numeric
	Local nMM  as numeric

	cHour := AllTrim( cHour )
	nPos  := At( ":", cHour )

	// Sem ":" = horas inteiras, não há minuto para validar
	If nPos == 0
		Return .T.
	EndIf

	nMM := Val( SubStr( cHour, nPos + 1 ) )

	If nMM < 0 .Or. nMM > 59
		Return (Help( , , " HELP", , "Valor de minutos inválido", 1, 0 ), .F.)
	EndIf

Return .T.

User Function CodToDef( aItens as array, nPos as integer, cAlias as character, cRet as character )

	Local lRet := .T.
	Local n1 as integer
	Local n2 as integer
	Local cQuery as character
	Local cAliasQry as character
	Local aCods := {}
	Local aDefs := {}

	// Captura todos os códigos diferentes presentes no array
	For n1 := 1 to Len(aItens)
		If aScan( aCods, aItens[n1,nPos] ) == 0
			aAdd( aCods, aItens[n1,nPos] )
		EndIf
	Next n1

	// Busca e armazena a definição de cada código
	For n1 := 1 to Len(aCods)
		cQuery := U_QuerySet( cAlias, { cRet }, { {  FormatStr("%c.%c_COD = ", cAlias, cAlias), aCods[n1]} } )
		cAliasQry := MPSysOpenQuery(cQuery)

		If !(cAliasQry)->(EoF())
			aAdd( aDefs, (cAliasQry)->( FieldGet( FieldPos(cRet) ) ) )
		Else
			lRet := .F.
			Help( , , " HELP", , "Código " + AllTrim(aCods[n1]) + " não existe na tabela " + cAlias, 1, 0 )
			(cAliasQry)->(dbCloseArea())
			exit
		EndIf

		(cAliasQry)->(dbCloseArea())
	Next n1

	// Substitui os códigos pelos valores correspondentes
	If lRet
		For n1 := 1 to Len(aItens)
			n2 := aScan( aCods, aItens[n1,nPos] )
			If n2 > 0
				aItens[n1,nPos] := aDefs[n2]
			EndIf
		Next n1
	EndIf

Return lRet

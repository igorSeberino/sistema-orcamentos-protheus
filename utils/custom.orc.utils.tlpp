#include "totvs.ch"
#include "fwmvcdef.ch"

namespace custom.orc.utils
using namespace custom.orc.orcamento.manutencao

/*/{Protheus.doc} ModelActivate
	Ponto de ativacao do Model (SetActivate) do cadastro de Áreas (ZB1).
	Executado ao ativar o formulario; na operacao de INCLUIR, gera o
	codigo sequencial do produto (ZB1_COD) via GetSXENum, garantindo que
	o codigo nao esteja em uso (checagem via CodExiste) antes de
	gravar o valor no Model.

	@type user function

	@author igor.seberino

	@since 22/10/2026

	@param oModel

	@see ZA1CodExiste
/*/
User Function ModelActivate( oModel, cAlias )

    Local cCodigo
    Local cCodField := cAlias + "_COD"
    Local cModel := cAlias + "MASTER"

    If oModel:GetOperation() == MODEL_OPERATION_INSERT

        cCodigo := GetSXENum( cAlias, cCodField )

        Do While U_CodExiste(cCodigo, cAlias)

            cCodigo := GetSXENum( cAlias, cCodField )
            
        EndDo

        oModel:SetValue( cModel, cCodField, cCodigo )

    EndIf

Return 

/*/{Protheus.doc} CodExiste
	Verifica se ja existe produto (nao deletado) com o codigo
	informado.

	@type user function

	@author igor.seberino

	@since 22/10/2026

	@param cCod, character

	@return logical, .T.=Existe, .F.=Nao Existe
/*/
User Function CodExiste( cCod, cAlias )

    Local lExiste := .F.
    Local cCodField := cAlias + '_COD'
    Local cCodFieldSearch := cAlias + "." + cCodField + " = "

    Local cQuery := U_QuerySet( cAlias, { cCodField }, { { cCodFieldSearch, cCod } } )

    Local cAliasQry := MPSysOpenQuery(cQuery)

    lExiste := !(cAliasQry)->(EoF())

    (cAliasQry)->(dbCloseArea())

Return lExiste

/*/{Protheus.doc} QuerySet
	Monta uma query de acordo com os parametros passados.
    Protegida contra SQL Injection com FWPreparedStatement

	@type user function

	@author igor.seberino

	@since 22/10/2026

	@param cAlias, character
    
    @param aParamsSelect, array, parametros que deseja como retorno

    @param aParamsWhere, array, parametros que deseja filtrar,
    formato { {Campo + Operador}, {Valor} }
    exemplo [ {ZA1.ZA1_COD =}, {000004} ]

	@return cQueryRet, query montada
/*/
User Function QuerySet( cAlias, aParamsSelect, aParamsWhere )

    Local oStmt := FWPreparedStatement():New()
    Local cQueryBase as character
    Local cQueryRet as character
    Local nI as integer

    // Começa a montar a query
    cQueryBase := " SELECT "

    // Adiciona parâmetros conforme passado
    // no array, de forma dinâmica
    For nI := 1 to Len(aParamsSelect)
        If nI != 1
            cQueryBase += ", "
        EndIf
        cQueryBase += aParamsSelect[nI]
    Next nI

    // Adição dinâmica de table
    cQueryBase += " FROM " + RetSQLName(cAlias) + " " +  cAlias

    // Adiciona parâmetros conforme passado
    // no array, de forma dinâmica
    If Len(aParamsWhere) > 0
        For nI := 1 to Len(aParamsWhere)
            If nI == 1
                cQueryBase += " WHERE " + cAlias + ".D_E_L_E_T_ = ' ' "
                cQueryBase += " AND " + aParamsWhere[nI][1] + " ? "
            Else
                cQueryBase += " AND " + aParamsWhere[nI][1] + " ? "
            EndIf
        Next nI
    // Garante o filtro de itens deletados
    // mesmo sem parâmetros de busca
    Else   
        cQueryBase += " WHERE " + cAlias + ".D_E_L_E_T_ = ' ' "
    EndIf

    oStmt:SetQuery(cQueryBase)

    // Preenchimento dinâmico dos parâmetros
    // de busca    
    For nI := 1 to Len(aParamsWhere)

        If ValType(aParamsWhere[nI][2]) == "C"

            oStmt:SetString(nI, aParamsWhere[nI][2])

        ElseIf ValType(aParamsWhere[nI][2]) == "N"

            oStmt:SetNumeric(nI, aParamsWhere[nI][2])

        ElseIf ValType(aParamsWhere[nI][2]) == "D"

            oStmt:SetDate(nI, aParamsWhere[nI][2])

        ElseIf ValType(aParamsWhere[nI][2]) == "L"

            oStmt:SetLogical(nI, aParamsWhere[nI][2])

        EndIf

    Next nI

    cQueryRet := oStmt:GetFixQuery()

Return cQueryRet


/*/{Protheus.doc} HoursToNum
	Converte texto hh:mm em horas decimais. Ex.: "08:30" -> 8.5

	@type user function

	@author igor.seberino

	@since 27/10/2026

	@return logical
/*/
User Function HoursToNum( cHour ) 

	Local nHH as numeric
	Local nMM as numeric
    Local nValue as numeric
    Local nHourLength := Len(cHour) - 3

	// Captura hora e minuto do campo
	nHH := Val( Left( cHour, nHourLength ) )
	nMM := Val( Right( cHour , 2 ) )

	// Converte caracter para numérico
	nValue := Round( nHH + ( nMM / 60 ), 2 )

Return nValue

/*/{Protheus.doc} NumToHours
	Converte horas decimais em texto

	@type user function

	@author igor.seberino

	@since 27/10/2026

	@return logical
/*/
User Function NumToHours( nValue, nTam ) 

    Local cHour as character
	Local nDecimais := nValue - Int(nValue)

    cHour := StrZero(Int(nValue), nTam - 3) + ":" + StrZero(Round(nDecimais * 60, 0), 2)

Return cHour

User Function HoursToDays( nValue )
Return nValue / 8.5

User Function TotalHrsCharSet( nTotal, cModel )

	Local oModelActive := FWModelActive()
    Local oModel := oModelActive:GetModel(cModel)
	Local oStruct  := oModel:GetStruct()

	Local cField := Left(cModel, 3) + "_TOTHR"

	oStruct:SetProperty( cField, MODEL_FIELD_WHEN, { || .T. } )

	oModel:SetValue( cField, U_NumToHours(nTotal, 10) )

	oStruct:SetProperty( cField, MODEL_FIELD_WHEN, { || .F. } )

Return .T.

User Function OnHrDayChange( nHrDia )

	Local oModel    := FWModelActive()
	Local oModelZB5 as object
	Local oModelZB6 as object
	Local n1 as numeric
	Local n2 as numeric
    Local aSaveRows as array
    Local nDoc as numeric
    Local nDev as numeric
    Local nAna as numeric
    Local nVal as numeric

	If M->ZB4_TTHRNM > 0

        aSaveRows := FWSaveRows()

		oModelZB5 := oModel:GetModel("ZB5DETAIL")
		oModelZB6 := oModel:GetModel("ZB6DETAIL")

		If MsgYesNo("Deseja recalcular as horas a partir dos dias? Sim: recalcula as horas a partir dos dias. Não: mantém as horas e recalcula os dias")
			// Valida os dias novamente

			For n1 := 1 to oModelZB5:Length()

				If !oModelZB5:IsDeleted(n1)

                    oModelZB5:GoLine(n1)

					For n2 := 1 to oModelZB6:Length()

						If !oModelZB6:IsDeleted(n2)

                            oModelZB6:GoLine(n2)

                            nDoc := oModelZB6:GetValue("ZB6_DDOC") * nHrDia
                            nDev := oModelZB6:GetValue("ZB6_DDEV") * nHrDia
                            nAna := oModelZB6:GetValue("ZB6_DANA") * nHrDia
                            nVal := oModelZB6:GetValue("ZB6_DVAL") * nHrDia

                            oModelZB6:SetValue( "ZB6_HDOC", U_NumToHours(nDoc, 8) )
                            oModelZB6:SetValue( "ZB6_HDEV", U_NumToHours(nDev, 8) )
                            oModelZB6:SetValue( "ZB6_HANA", U_NumToHours(nAna, 8) )
                            oModelZB6:SetValue( "ZB6_HVAL", U_NumToHours(nVal, 8) )

						EndIf

					Next n2

				EndIf

			Next n1

		Else
			// Valida as horas novamente

			For n1 := 1 to oModelZB5:Length()

				If !oModelZB5:IsDeleted(n1)

                    oModelZB5:GoLine(n1)

					For n2 := 1 to oModelZB6:Length()

						If !oModelZB6:IsDeleted(n2)

                            oModelZB6:GoLine(n2)

                            nDoc := oModelZB6:GetValue("ZB6_HDOCNM") / nHrDia
                            nDev := oModelZB6:GetValue("ZB6_HDEVNM") / nHrDia
                            nAna := oModelZB6:GetValue("ZB6_HANANM") / nHrDia
                            nVal := oModelZB6:GetValue("ZB6_HVALNM") / nHrDia

                            oModelZB6:SetValue( "ZB6_DDOC", nDoc )
                            oModelZB6:SetValue( "ZB6_DDEV", nDev )
                            oModelZB6:SetValue( "ZB6_DANA", nAna )
                            oModelZB6:SetValue( "ZB6_DVAL", nVal )

						EndIf

					Next n2

				EndIf

			Next n1

		EndIf
		
	EndIf

Return .T.

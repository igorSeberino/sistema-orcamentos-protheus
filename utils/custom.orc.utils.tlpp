#include "totvs.ch"
#include "fwmvcdef.ch"
#include "custom.orc.th"

namespace custom.orc.utils

/*/{Protheus.doc} RegEmUso
	Verifica se existe registro (não deletado) na tabela com os
	filtros informados. Usado para saber se um cadastro já foi
	usado antes de excluir.

	@type user function

	@author igor.seberino

	@since 26/11/2026

	@param cAlias, character, Tabela consultada (ex.: "ZB5")
	@param aWhere, array, Filtros no formato do QuerySet: { { "ZB5.ZB5_AREA = ", cCod } }

	@return logical, .T. se existe pelo menos um registro
/*/
User Function RegEmUso( cAlias as character, aWhere as array ) as logical

	Local cQuery    := U_QuerySet( cAlias, { cAlias + "_FILIAL" }, aWhere ) as character
	Local cAliasQry := MPSysOpenQuery( cQuery ) as character
	Local lExiste   := !(cAliasQry)->(EoF()) as logical

	(cAliasQry)->(dbCloseArea())

Return lExiste

/*/{Protheus.doc} EhAprovador
	Verifica se o usuário está cadastrado como aprovador ativo (ZB3).

	@type user function

	@author igor.seberino

	@since 26/11/2026

	@param cUser, character, Código do usuário

	@return logical, .T. se é aprovador ativo
/*/
User Function IsAprovador( cUser as character ) as logical
Return U_RegEmUso( "ZB3", { { "ZB3.ZB3_USER = ", cUser }, { "ZB3.ZB3_ATIVO = ", ATIVO_SIM } } )

/*/{Protheus.doc} ExcOuInativa
	Exclusão dos cadastros (ZORCA01-03). Se o registro posicionado
	não está em uso, abre a tela de exclusão. Se está em uso e ativo,
	oferece inativar. Se está em uso e já inativo, só avisa.

	@type user function

	@author igor.seberino

	@since 26/11/2026

	@param cNamespace, character, Namespace do fonte (ex.: NZORCA01)
	@param cRotina, character, Rotina (ex.: "ZORCA01")
	@param cAlias, character, Tabela do cadastro (ex.: "ZB1")
	@param lEmUso, logical, .T. se o registro já foi usado
	@param cPergunta, character, Pergunta exibida para inativar
	@param cTitulo, character, Título da pergunta
	@param cJaInativo, character, Aviso quando o registro já está inativo
/*/
User Function ExcOuInativa( cNamespace as character, cRotina as character, cAlias as character, lEmUso as logical, ;
		cPergunta as character, cTitulo as character, cJaInativo as character )

	Local cFonte    := cNamespace + ".U_" + cRotina as character
	Local cSubModel := cAlias + "MASTER" as character
	Local cCampoAtv := cAlias + "_ATIVO" as character
	Local oModel    as object

	If !lEmUso
		FWExecView( "Excluir", cFonte, MODEL_OPERATION_DELETE )

	ElseIf (cAlias)->( FieldGet( FieldPos( cCampoAtv ) ) ) == ATIVO_SIM

		If MsgYesNo( cPergunta, cTitulo )
			oModel := FWLoadModel( cFonte )
			oModel:SetOperation( MODEL_OPERATION_UPDATE )
			oModel:Activate()
			oModel:SetValue( cSubModel, cCampoAtv, ATIVO_NAO )

			If oModel:VldData()
				oModel:CommitData()
			Else
				Help( , , cRotina + "EXC", , oModel:GetErrorMessage()[6], 1, 0, ;
					, , , , , { "Contate o suporte." } )
			EndIf

			oModel:DeActivate()
		EndIf

	Else
		Aviso( "ATENÇÃO", cJaInativo, { "Ok" } )
	EndIf

Return

/*/{Protheus.doc} QuerySet
	Monta uma query de acordo com os parâmetros passados.
	Protegida contra SQL Injection com FWPreparedStatement.
	Sempre filtra D_E_L_E_T_ e filial.

	@type user function

	@author igor.seberino

	@since 22/10/2026

	@param cAlias, character, Tabela consultada
	@param aParamsSelect, array, Campos que deseja como retorno
	@param aParamsWhere, array, Filtros no formato { { Campo + Operador, Valor } }, ex.: { { "ZA1.ZA1_COD = ", "000004" } }

	@return character, Query montada
/*/
User Function QuerySet( cAlias as character, aParamsSelect as array, aParamsWhere as array ) as character

	Local oStmt := FWPreparedStatement():New() as object
	Local cQueryBase as character
	Local cQueryRet as character
	Local nI as integer

	// Começa a montar a query
	cQueryBase := " SELECT "

	// Adiciona parâmetros conforme passado
	// no array, de forma dinâmica
	For nI := 1 to Len(aParamsSelect)
		If nI != 1
			cQueryBase += ", "
		EndIf
		cQueryBase += aParamsSelect[nI]
	Next nI

	// Adição dinâmica de table
	cQueryBase += " FROM " + RetSQLName(cAlias) + " " +  cAlias

	// Adiciona parâmetros conforme passado
	// no array, de forma dinâmica
	If Len(aParamsWhere) > 0
		For nI := 1 to Len(aParamsWhere)
			If nI == 1
				cQueryBase += " WHERE " + cAlias + ".D_E_L_E_T_ = ' ' "
				cQueryBase += " AND " + cAlias + "_FILIAL = ? "
				cQueryBase += " AND " + aParamsWhere[nI][1] + " ? "
			Else
				cQueryBase += " AND " + aParamsWhere[nI][1] + " ? "
			EndIf
		Next nI
		// Garante o filtro de itens deletados
		// mesmo sem parâmetros de busca
	Else
		cQueryBase += " WHERE " + cAlias + ".D_E_L_E_T_ = ' ' "
		cQueryBase += " AND " + cAlias + "_FILIAL = ? "
	EndIf

	oStmt:SetQuery(cQueryBase)

	oStmt:SetString(1, xFilial(cAlias))

	// Preenchimento dinâmico dos parâmetros
	// de busca
	For nI := 1 to Len(aParamsWhere)

		If ValType(aParamsWhere[nI][2]) == "C"

			oStmt:SetString(nI + 1, aParamsWhere[nI][2])

		ElseIf ValType(aParamsWhere[nI][2]) == "N"

			oStmt:SetNumeric(nI + 1, aParamsWhere[nI][2])

		ElseIf ValType(aParamsWhere[nI][2]) == "D"

			oStmt:SetDate(nI + 1, aParamsWhere[nI][2])

		ElseIf ValType(aParamsWhere[nI][2]) == "L"

			oStmt:SetLogical(nI + 1, aParamsWhere[nI][2])

		EndIf

	Next nI

	cQueryRet := oStmt:GetFixQuery()

Return cQueryRet

/*/{Protheus.doc} HoursToNum
	Converte texto hh:mm em horas decimais. Ex.: "08:30" -> 8.5

	@type user function

	@author igor.seberino

	@since 27/10/2026

	@param cHour, character, Horas no formato hh:mm (ou só hh)

	@return numeric, Horas em decimal
/*/
User Function HoursToNum( cHour as character ) as numeric

	Local nPos as numeric
	Local nHH  as numeric
	Local nMM  as numeric

	cHour := StrTran( AllTrim( cHour ), ".", "" )
	nPos  := At( ":", cHour )

	If nPos == 0
		// Sem ":" = horas inteiras ("8" = 8:00)
		nHH := Val( cHour )
		nMM := 0
	Else
		nHH := Val( Left( cHour, nPos - 1 ) )
		nMM := Val( SubStr( cHour, nPos + 1 ) )
	EndIf

Return Round( nHH + ( nMM / 60 ), 2 )

/*/{Protheus.doc} NumToHours
	Converte horas decimais em texto h:mm. Ex.: 8.5 -> "8:30"

	@type user function

	@author igor.seberino

	@since 27/10/2026

	@param nValue, numeric, Horas em decimal

	@return character, Horas no formato h:mm
/*/
User Function NumToHours( nValue as numeric ) as character

	Local nMinutos := Round( nValue * 60, 0 ) as numeric       // arredonda o total em minutos
	Local nHH      := Int( nMinutos / 60 ) as numeric
	Local nMM      := nMinutos % 60 as numeric
	Local cHH      := AllTrim( Transform( nHH, "@E 999,999,999" ) ) as character

Return cHH + ":" + StrZero( nMM, 2 )

/*/{Protheus.doc} TotalHrsCharSet
	Grava o total de horas (texto) do submodelo e recalcula
	o total do submodelo pai

	@type user function

	@author igor.seberino

	@since 03/11/2026

	@param nTotal, numeric, Total de horas em decimal
	@param cModel, character, Submodelo (ZB5DETAIL ou ZB6DETAIL)

	@return logical, sempre .T.
/*/
User Function TotalHrsCharSet( nTotal as numeric, cModel as character ) as logical

	Local oModel := FWModelActive() as object
	Local cAlias := Left( cModel, 3 ) as character
	Local cPai   as character

	oModel:GetModel( cModel ):LoadValue( cAlias + "_TOTHR", U_NumToHours( nTotal ) )

	Do Case
	Case cModel == "ZB6DETAIL"
		cPai := "ZB5DETAIL"
	Case cModel == "ZB5DETAIL"
		cPai := "ZB4MASTER"
	Otherwise
		cPai := ""
	EndCase

	// CalcHrsRows fica no fonte do ZORCA04 (NZORCA04): chamada com o namespace completo
	If !Empty( cPai )
		custom.orc.orcamento.manutencao.U_CalcHrsRows( cModel, cAlias + "_TTHRNM", cPai, Left( cPai, 3 ) + "_TTHRNM" )
	EndIf

Return .T.

/*/{Protheus.doc} OnHrDayChange
	Recalcula todas as atividades e todos os itens
	na alteração do Hrs/Dia, a partir do novo valor.
	Demais gatilhos e atualizações partem dos campos
	alterados aqui

	@type user function

	@author igor.seberino

	@since 03/11/2026

	@param nHrDia, numeric, Novo Horas/Dia em decimal

	@return logical, sempre .T.
/*/
User Function OnHrDayChange( nHrDia as numeric ) as logical

	Local oModel    := FWModelActive() as object
	Local oModelZB5 as object
	Local oModelZB6 as object
	Local n1 as numeric
	Local n2 as numeric
	Local aSaveRows as array
	Local nDoc as numeric
	Local nDev as numeric
	Local nAna as numeric
	Local nVal as numeric
	Local nOpcao as numeric

	// Verifica se já foram calculadas as horas de algo (necessário recalcular)
	If M->ZB4_TTHRNM > 0

		// Salva a linha que estava posicionada de cada model
		aSaveRows := FWSaveRows()

		If !IsBlind()
			nOpcao := Aviso( "Horas/Dia alterado", "Já existem horas lançadas, como deseja recalcular?", { "Recalc. Horas", "Recalc. Dias" } )
		Else
			nOpcao := 1 // Recalcula horas por default
		EndIf

		oModelZB5 := oModel:GetModel("ZB5DETAIL")
		oModelZB6 := oModel:GetModel("ZB6DETAIL")

		If nOpcao == 1
			// Valida os dias novamente

			// Percorre cada item do orçamento
			For n1 := 1 to oModelZB5:Length()

				If !oModelZB5:IsDeleted(n1)

					oModelZB5:GoLine(n1)

					// Percorre cada atividade do item
					For n2 := 1 to oModelZB6:Length()

						If !oModelZB6:IsDeleted(n2)

							oModelZB6:GoLine(n2)

							// Grava recalculado em cada campo
							nDoc := oModelZB6:GetValue("ZB6_DDOC") * nHrDia
							nDev := oModelZB6:GetValue("ZB6_DDEV") * nHrDia
							nAna := oModelZB6:GetValue("ZB6_DANA") * nHrDia
							nVal := oModelZB6:GetValue("ZB6_DVAL") * nHrDia

							oModelZB6:SetValue( "ZB6_HDOC", U_NumToHours(nDoc) )
							oModelZB6:SetValue( "ZB6_HDEV", U_NumToHours(nDev) )
							oModelZB6:SetValue( "ZB6_HANA", U_NumToHours(nAna) )
							oModelZB6:SetValue( "ZB6_HVAL", U_NumToHours(nVal) )

						EndIf

					Next n2

				EndIf

			Next n1

		Else
			// Valida as horas novamente

			// Percorre cada item do orçamento
			For n1 := 1 to oModelZB5:Length()

				If !oModelZB5:IsDeleted(n1)

					oModelZB5:GoLine(n1)

					// Percorre cada atividade do item
					For n2 := 1 to oModelZB6:Length()

						If !oModelZB6:IsDeleted(n2)

							oModelZB6:GoLine(n2)

							// Grava recalculado em cada campo
							nDoc := oModelZB6:GetValue("ZB6_HDOCNM") / nHrDia
							nDev := oModelZB6:GetValue("ZB6_HDEVNM") / nHrDia
							nAna := oModelZB6:GetValue("ZB6_HANANM") / nHrDia
							nVal := oModelZB6:GetValue("ZB6_HVALNM") / nHrDia

							oModelZB6:SetValue( "ZB6_DDOC", nDoc )
							oModelZB6:SetValue( "ZB6_DDEV", nDev )
							oModelZB6:SetValue( "ZB6_DANA", nAna )
							oModelZB6:SetValue( "ZB6_DVAL", nVal )

						EndIf

					Next n2

				EndIf

			Next n1

		EndIf

		// Retorna às linhas originais
		FWRestRows( aSaveRows )

	EndIf

Return .T.

/*/{Protheus.doc} VldDefin
	Valida definição caso seja escrita pelo usuário,
	verificando se está ativa ou existe.

	@type user function

	@author igor.seberino

	@since 03/11/2026

	@param cDefin, character, Código da definição (ZB2)

	@return logical, .T. se existe e está ativa
/*/
User Function VldDefin( cDefin as character ) as logical

	Local cQuery    := U_QuerySet( "ZB2", {"ZB2_COD"}, {{"ZB2.ZB2_COD = ", cDefin}, {"ZB2.ZB2_ATIVO = ", ATIVO_SIM}} ) as character
	Local cAliasQry := MPSysOpenQuery(cQuery) as character
	Local lRet      := .T. as logical

	If (cAliasQry)->(EoF())
		Help( , , "HELP", , "Definição não existe ou está inativa", 1, 0 )
		lRet := .F.
	EndIf

	(cAliasQry)->(dbCloseArea())

Return lRet

/*/{Protheus.doc} VldArea
	Valida área caso seja escrita pelo usuário,
	verificando se está ativa ou existe.

	@type user function

	@author igor.seberino

	@since 03/11/2026

	@param cArea, character, Código da área (ZB1)

	@return logical, .T. se existe e está ativa
/*/
User Function VldArea( cArea as character ) as logical

	Local cQuery    := U_QuerySet( "ZB1", {"ZB1_COD"}, {{"ZB1.ZB1_COD = ", cArea}, {"ZB1.ZB1_ATIVO = ", ATIVO_SIM}} ) as character
	Local cAliasQry := MPSysOpenQuery(cQuery) as character
	Local lRet      := .T. as logical

	If (cAliasQry)->(EoF())
		Help( , , "HELP", , "Área não existe ou está inativa", 1, 0 )
		lRet := .F.
	EndIf

	(cAliasQry)->(dbCloseArea())

Return lRet

/*/{Protheus.doc} VldAprov
	Valida se o usuário existe e se
	já está cadastrado como aprovador

	@type user function

	@author igor.seberino

	@since 03/11/2026

	@param cUser, character, Código do usuário

	@return logical, .T. se existe e ainda não é aprovador
/*/
User Function VldAprov( cUser as character ) as logical

	Local cQuery    := U_QuerySet( "ZB3", {"ZB3_USER"}, {{"ZB3.ZB3_USER = ", cUser}} ) as character
	Local cAliasQry := MPSysOpenQuery(cQuery) as character
	Local lRet      := .T. as logical

	If !UsrExist(cUser)
		Help( , , "HELP", , "Usuário não existe", 1, 0 )
		lRet := .F.
	ElseIf !(cAliasQry)->(EoF())
		Help( , , "HELP", , "Aprovador já cadastrado", 1, 0 )
		lRet := .F.
	EndIf

	(cAliasQry)->(dbCloseArea())

Return lRet

/*/{Protheus.doc} VldHours
	Valida os minutos de um texto hh:mm (00 a 59)

	@type user function

	@author igor.seberino

	@since 12/11/2026

	@param cHour, character, Horas no formato hh:mm (ou só hh)

	@return logical, .T. se os minutos são válidos
/*/
User Function VldHours( cHour as character ) as logical

	Local nPos as numeric
	Local nMM  as numeric
	Local lRet := .T. as logical

	cHour := AllTrim( cHour )
	nPos  := At( ":", cHour )

	// Sem ":" = horas inteiras, não há minuto para validar
	If nPos > 0

		nMM := Val( SubStr( cHour, nPos + 1 ) )

		If nMM < 0 .Or. nMM > 59
			Help( , , "HELP", , "Valor de minutos inválido", 1, 0 )
			lRet := .F.
		EndIf

	EndIf

Return lRet

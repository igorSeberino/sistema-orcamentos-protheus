#include "totvs.ch"
#include "fwmvcdef.ch"
#include "custom.orc.th"

namespace custom.orc.orcamento.aprovacao
using namespace custom.orc.utils

/*/{Protheus.doc} ZORCA05
	Fluxo de status do orçamento: envio, aprovação/reprovação,
	novo rascunho e estorno (chamado pelo menu do ZORCA04)

	@type user function

	@author igor.seberino

	@since 05/11/2026

	@param cAction, character, Ação: APR = Aprovar, ENV = Enviar, NOV = Novo rascunho, EST = Estornar

	@return logical, sempre .T.
/*/
User Function ZORCA05( cAction as character ) as logical

	Local oModal := FWDialogModal():New() as object
	Local oPanel := oModal:GetPanelMain() as object

	Do Case
	Case cAction == 'APR'
		Revisar( oModal, oPanel )
	Case cAction == 'ENV'
		Envio( oModal, oPanel )
	Case cAction == 'NOV'
		NovoRascunho( oModal, oPanel )
	Case cAction == 'EST'
		Estornar( oModal, oPanel )
	EndCase

Return .T.

/*/{Protheus.doc} MontaTela
	Monta o diálogo de confirmação de cada ação, com os dados
	do orçamento posicionado

	@type static function

	@author igor.seberino

	@since 05/11/2026

	@param oModal, object, Diálogo (FWDialogModal)
	@param oPanel, object, Painel principal do diálogo
	@param cAction, character, Ação (APR, ENV, NOV, EST)
	@param cObs, character, Observação digitada (por referência)

	@return numeric, Opção confirmada (APR: 1 = Aprovar, 2 = Reprovar; demais: 2). 0 = cancelado
/*/
Static Function MontaTela( oModal as object, oPanel as object, cAction as character, cObs as character ) as numeric

	Local bCode  as codeblock
	Local nOpcao as numeric
	Local nRet   := 0 as numeric

	Local cTextHtml := '<hr size="1">'+;
		' <font size="2" ><b>ORÇAMENTO: </b> ' + ZB4->ZB4_COD + ' / ' + ZB4->ZB4_REV + ' </font> ' +;
		' <font size="2" > <b> CLIENTE: </b> ' + Posicione("SA1", 1, xFilial("SA1") + ZB4->ZB4_CLIENT + ZB4->ZB4_LOJA, "A1_NOME") +  ' </font><br/><br/>' +;
		' <font size="2"><b>TÍTULO: </b> ' + ZB4->ZB4_TITULO +  ' </font><br/><br/>' +;
		' <font size="2"><b>TICKET: </b> ' + ZB4->ZB4_TICKET +  ' </font> ' +;
		' <font size="2" > <b> TASK: </b> ' + ZB4->ZB4_TASK +  ' </font><br/><br/>' +;
		' <font size="2"><b>CRIADO POR: </b> ' + ZB4->ZB4_USRINC +  ' </font> ' +;
		' <font size="2" > <b> TOTAL: </b> ' + U_NumToHours( ZB4->ZB4_TTHRNM)  +  ' </font><br/><br/>' as character

	If cAction == "APR"

		cObs   := ""
		nOpcao := 1
		bCode := { || nRet := ConfAprov( nOpcao, cObs, oModal ) }

		oModal:SetEscClose(.T.)
		oModal:SetTitle("Aprovação do Orçamento")
		oModal:SetSize(110, 515) // altura, largura
		oModal:CreateDialog()

		TSay():New( 015, 230, { || "<b>OBSERVAÇÃO (máx. 250 caracteres)</b>" }, oPanel, , , , , , .T., , , 100, 010, , , , , , .T. )

		TMultiGet():New( 025, 230, { |u| If( PCount() > 0, cObs := u, cObs ) }, oPanel, 280, 060, , , , , , .T. )

		// Ação
		TRadMenu():New(080, 010, {"Aprovar", "Reprovar"}, { |u| If( PCount() > 0, nOpcao := u, nOpcao ) }, oPanel, , , , , , , , 100, 20, , , , .F., .T.)

	ElseIf cAction == "ENV"

		bCode := {  || nRet := 2, oModal:DeActivate() }

		oModal:SetEscClose(.T.)
		oModal:SetTitle("Enviar rascunho")
		oModal:SetSize(110, 315) // altura, largura
		oModal:CreateDialog()

	ElseIf cAction == "NOV"

		bCode := {  || nRet := 2, oModal:DeActivate() }

		oModal:SetEscClose(.T.)
		oModal:SetTitle("Gerar nova revisão")
		oModal:SetSize(110, 315) // altura, largura
		oModal:CreateDialog()

	ElseIf cAction == "EST"

		cObs   := ""
		bCode := { || nRet := ConfEstorno( cObs, oModal ) }

		oModal:SetEscClose(.T.)
		oModal:SetTitle("Estornar Orçamento")
		oModal:SetSize(110, 515) // altura, largura
		oModal:CreateDialog()

		TSay():New( 015, 230, { || "<b>OBSERVAÇÃO (máx. 250 caracteres)</b>" }, oPanel, , , , , , .T., , , 100, 010, , , , , , .T. )

		TMultiGet():New( 025, 230, { |u| If( PCount() > 0, cObs := u, cObs ) }, oPanel, 280, 060, , , , , , .T. )

	EndIf

	TSay():New( 015, 010, { || cTextHtml },       oPanel, , , , , , .T., , , 200, 060, , , , , , .T. )

	// Botao dentro do painel
	TButton():New(095, 010, "Visualizar Orçamento", oPanel, {|| FWExecView("Visualizar", FormatStr("VIEWDEF.%c.ZORCA04", NZORCA04), MODEL_OPERATION_VIEW) }, 80, 15, , , , .T.)

	// Botões da barra inferior
	oModal:AddOkButton( bCode, "Confirmar" )
	oModal:AddCloseButton( Nil, "Cancelar" )

	oModal:Activate()

Return nRet

/*/{Protheus.doc} Envio
	Envia o rascunho para aprovação: valida pelo modelo do ZORCA04,
	troca o status para Enviado e grava o histórico

	@type static function

	@author igor.seberino

	@since 05/11/2026

	@param oModal, object, Diálogo (FWDialogModal)
	@param oPanel, object, Painel principal do diálogo

	@return logical, .T. se enviou
/*/
Static Function Envio( oModal as object, oPanel as object ) as logical

	Local lRet  := .T. as logical
	Local cErro as character

	// Carrega o modelo de dados
	Local oModel := FWLoadModel(NZORCA04 + ".U_ZORCA04") as object

	// Verificação extra caso VldActivate() não funcione
	If ZB4->ZB4_STATUS != STATUS_RASCUNHO
		Help( , , "ZORCA05", , "Somente orçamento em rascunho pode ser enviado.", 1, 0 )
		Return .F.
	EndIf

	// Declara operação de update
	oModel:SetOperation(MODEL_OPERATION_UPDATE)

	// ATIVA O MODELO (Agora sim ele está operável)
	If !oModel:Activate()
		lRet := .F.

	ElseIf !VldEnvio( oModel )
		Help( , , "ZORCA05", , "Cada item do orçamento deve ter pelo menos 1 atividade", 1, 0 )

		lRet := .F.

	ElseIf MontaTela( oModal, oPanel, "ENV" ) == 2

		Begin Transaction

			If oModel:SetValue("ZB4MASTER", "ZB4_STATUS", STATUS_ENVIADO) .And. oModel:VldData() .And. oModel:CommitData() //VldData() garante que o modelo passe pelas validações de negócio

				If !GravaHist( ACAO_ENVIADO )
					DisarmTransaction()
					cErro := "Ocorreu um erro ao gravar o histórico"
				EndIf

			Else
				DisarmTransaction()
				cErro := "Ocorreu um erro inesperado"
			EndIf

		End Transaction

		If !Empty( cErro )
			Help( , , "ZORCA05", , cErro, 1, 0 )
			lRet := .F.
		EndIf

	Else
		lRet := .F.
	EndIf

	If oModel:IsActive()
		// Desativa o modelo, necessário para liberar o lock.
		oModel:DeActivate()
	EndIf

Return lRet

/*/{Protheus.doc} Revisar
	Aprova ou reprova o orçamento enviado, com lock e releitura
	do status, e grava o histórico

	@type static function

	@author igor.seberino

	@since 05/11/2026

	@param oModal, object, Diálogo (FWDialogModal)
	@param oPanel, object, Painel principal do diálogo

	@return logical, .F. se não pôde abrir a revisão
/*/
Static Function Revisar( oModal as object, oPanel as object ) as logical

	Local nOpcao as numeric
	Local aArea  as array
	Local cObs   as character
	Local cErro  as character

	If ZB4->ZB4_STATUS != STATUS_ENVIADO
		Help( , , "ZORCA05", , "O orçamento não foi enviado para revisão.", 1, 0 )
		Return .F.
	EndIf

	If !VldAprovador()
		Return .F.
	EndIf

	nOpcao := MontaTela( oModal, oPanel, "APR", @cObs )

	If nOpcao > 0

		aArea := GetArea()

		Begin Transaction

			If RecLock("ZB4", .F.)

				If ZB4->ZB4_STATUS == STATUS_ENVIADO

					Do Case
					Case nOpcao == 1
						ZB4->ZB4_STATUS := STATUS_APROVADO
						If !GravaHist( ACAO_APROVADO, cObs )
							cErro := "Ocorreu um erro ao gravar o histórico"
							DisarmTransaction()
						EndIf
					Case nOpcao == 2
						ZB4->ZB4_STATUS := STATUS_REPROVADO
						If !GravaHist( ACAO_REPROVADO, cObs )
							cErro := "Ocorreu um erro ao gravar o histórico"
							DisarmTransaction()
						EndIf
					Otherwise
						cErro := "Ocorreu um erro inesperado"
						DisarmTransaction()
					EndCase

				Else
					cErro := "O status do orçamento foi alterado por outro usuário."
					DisarmTransaction()

				EndIf

				ZB4->( MsUnlock() )
			Else
				cErro := "Ocorreu um erro inesperado"
				DisarmTransaction()
			EndIf

		End Transaction

		If !Empty( cErro )
			Help( , , "ZORCA05", , cErro, 1, 0 )
		EndIf

		RestArea( aArea )

	EndIf

Return .T.

/*/{Protheus.doc} NovoRascunho
	Gera a próxima revisão (rascunho) de um orçamento já revisado,
	abrindo o ZORCA04 em inclusão com os dados copiados

	@type static function

	@author igor.seberino

	@since 05/11/2026

	@param oModal, object, Diálogo (FWDialogModal)
	@param oPanel, object, Painel principal do diálogo

	@return logical, .F. se não pôde gerar a revisão
/*/
Static Function NovoRascunho( oModal as object, oPanel as object ) as logical

	Local oModel    := FWLoadModel(NZORCA04 + ".U_ZORCA04") as object
	Local nOpcao    as numeric
	Local cCod      := ZB4->ZB4_COD as character
	Local cRev      := StrZero( (Val(ZB4->ZB4_REV) + 1), 2 ) as character
	Local cQuery    := U_QuerySet( "ZB4", {"ZB4_COD"}, { {"ZB4_COD = ", cCod}, {"ZB4_REV = ", cRev} } ) as character
	Local cAliasQry := MPSysOpenQuery(cQuery) as character

	If ZB4->ZB4_STATUS != STATUS_APROVADO .And. ZB4->ZB4_STATUS != STATUS_REPROVADO
		Help( , , "ZORCA05", , "O orçamento precisa ter sido revisado para abrir um novo rascunho.", 1, 0 )
		(cAliasQry)->(dbCloseArea())
		Return .F.
	ElseIf !(cAliasQry)->(EoF())
		Help( , , "ZORCA05", , "O orçamento já tem um novo rascunho criado.", 1, 0 )
		(cAliasQry)->(dbCloseArea())
		Return .F.
	EndIf

	(cAliasQry)->(dbCloseArea())

	nOpcao := MontaTela( oModal, oPanel, "NOV" )

	If nOpcao > 0

		oModel:SetOperation(MODEL_OPERATION_INSERT)

		If oModel:Activate(.T.)

			oModel:LoadValue( "ZB4MASTER", "ZB4_COD", cCod )
			oModel:LoadValue( "ZB4MASTER", "ZB4_REV", cRev )

			// Limpa o histórico de revisão
			oModel:GetModel("ZB7DETAIL"):ClearData( .F., .T. )

			FWExecView( "Novo Rascunho", "VIEWDEF." + NZORCA04 + ".ZORCA04", MODEL_OPERATION_INSERT, , { || .T. }, , , , , , , oModel )

			If oModel:IsActive()
				oModel:DeActivate()
			EndIf

		EndIf

	EndIf

Return .T.

/*/{Protheus.doc} Estornar
	Estorna a aprovação: volta o orçamento para Enviado, limpa os
	dados de aprovação e grava o histórico

	@type static function

	@author igor.seberino

	@since 05/11/2026

	@param oModal, object, Diálogo (FWDialogModal)
	@param oPanel, object, Painel principal do diálogo

	@return logical, .F. se não pôde estornar
/*/
Static Function Estornar( oModal as object, oPanel as object ) as logical

	Local nOpcao as numeric
	Local aArea  as array
	Local cObs   as character
	Local cErro  as character

	If ZB4->ZB4_STATUS != STATUS_APROVADO
		Help( , , "ZORCA05", , "O orçamento só pode ser estornado após aprovação.", 1, 0 )
		Return .F.
	EndIf

	If !VldAprovador() .Or. !VldRevisao( ZB4->ZB4_COD, ZB4->ZB4_REV )
		Return .F.
	EndIf

	nOpcao := MontaTela( oModal, oPanel, "EST", @cObs )

	If nOpcao > 0

		aArea := GetArea()

		Begin Transaction

			If RecLock("ZB4", .F.)

				If ZB4->ZB4_STATUS == STATUS_APROVADO

					ZB4->ZB4_STATUS := STATUS_ENVIADO
					ZB4->ZB4_USRAPR := ""
					ZB4->ZB4_DTAPR  := CtoD("")
					ZB4->ZB4_HRAPR  := ""

					If !GravaHist( ACAO_ESTORNADO, cObs )
						cErro := "Ocorreu um erro ao gravar o histórico"
						DisarmTransaction()
					EndIf

				Else
					cErro := "O status do orçamento foi alterado por outro usuário."
					DisarmTransaction()

				EndIf

				ZB4->( MsUnlock() )

			Else
				cErro := "Ocorreu um erro inesperado"
				DisarmTransaction()
			EndIf

		End Transaction

		If !Empty( cErro )
			Help( , , "ZORCA05", , cErro, 1, 0 )
		EndIf

		RestArea( aArea )

	EndIf

Return .T.

/*/{Protheus.doc} VldEnvio
	Valida se cada item (ZB5) do orçamento tem pelo menos
	uma atividade (ZB6)

	@type static function

	@author igor.seberino

	@since 05/11/2026

	@param oModel, object, Modelo ZORCA04M ativo

	@return logical, .T. se todos os itens têm atividade
/*/
Static Function VldEnvio( oModel as object ) as logical

	Local oModelZB5 := oModel:GetModel("ZB5DETAIL") as object
	Local oModelZB6 := oModel:GetModel("ZB6DETAIL") as object
	Local n1        as numeric
	Local n2        as numeric
	Local lRet      := .T. as logical

	For n1 := 1 to oModelZB5:Length()

		oModelZB5:GoLine(n1)

		If !oModelZB5:IsDeleted(n1)

			For n2 := 1 to oModelZB6:Length()

				oModelZB6:GoLine(n2)

				If !oModelZB6:IsDeleted(n2) .And. !oModelZB6:IsEmpty()
					Exit
				ElseIf n2 == oModelZB6:Length()
					lRet := .F.
				EndIf
			Next n2
		EndIf
	Next n1

Return lRet

/*/{Protheus.doc} GravaHist
	Grava uma linha do histórico (ZB7) para o orçamento posicionado
	e, na aprovação/estorno, os dados de aprovação da ZB4

	@type static function

	@author igor.seberino

	@since 05/11/2026

	@param cAcao, character, Ação do histórico (ACAO_*)
	@param cObs, character, Observação

	@return logical, .T. se gravou
/*/
Static Function GravaHist( cAcao as character, cObs as character ) as logical

	Local aArea     := GetArea() as array
	Local lRet      := .F. as logical
	Local cSeq      := "001" as character
	Local cQuery    := U_QuerySet( "ZB7", { "MAX(ZB7_SEQ) ZB7_SEQ" }, { {"ZB7_COD = ", ZB4->ZB4_COD}, {"ZB7_REV = ", ZB4->ZB4_REV} } ) as character
	Local cAliasQry := MPSysOpenQuery( cQuery ) as character
	Local cUser     as character

	If !(cAliasQry)->(EoF())
		cSeq := StrZero(Val((cAliasQry)->ZB7_SEQ) + 1, 3)
	EndIf

	(cAliasQry)->( dbCloseArea() )

	If Reclock("ZB7", .T.) .And. !(cAcao != ACAO_ENVIADO .And. cAcao != ACAO_REPROVADO .And. !Reclock("ZB4", .F.))
		cUser := RetCodUsr()

		If cAcao == ACAO_APROVADO
			ZB4->ZB4_USRAPR := cUser
			ZB4->ZB4_DTAPR  := dDataBase
			ZB4->ZB4_HRAPR  := Left( Time(), 5 )
		ElseIf cAcao == ACAO_ESTORNADO
			ZB4->ZB4_USRAPR := ""
			ZB4->ZB4_DTAPR  := CtoD("")
			ZB4->ZB4_HRAPR  := ""
		EndIf

		ZB7->ZB7_FILIAL := xFilial("ZB7")
		ZB7->ZB7_COD := ZB4->ZB4_COD
		ZB7->ZB7_REV := ZB4->ZB4_REV
		ZB7->ZB7_SEQ := cSeq
		ZB7->ZB7_ACAO := cAcao
		ZB7->ZB7_USER := cUser
		ZB7->ZB7_DATA := dDataBase
		ZB7->ZB7_HORA := Left( Time(), 5 )
		ZB7->ZB7_OBS := cObs

		ZB7->( MsUnLock() )
		lRet := .T.

	EndIf

	RestArea( aArea )

Return lRet

/*/{Protheus.doc} VldAprovador
	Valida se o usuário logado é aprovador ativo e se não é
	o criador do orçamento posicionado

	@type static function

	@author igor.seberino

	@since 06/11/2026

	@return logical, .T. se pode aprovar/estornar
/*/
Static Function VldAprovador() as logical

	Local lRet  := .T. as logical
	Local cUser := RetCodUsr() as character

	If !U_IsAprovador( cUser )
		Help( , , "ZORCA05", , "Usuário não é aprovador ativo.", 1, 0 )
		lRet := .F.
	ElseIf ZB4->ZB4_STATUS != STATUS_RASCUNHO .And. cUser == ZB4->ZB4_USRINC
		Help( , , "ZORCA05", , "Aprovador deve ser diferente do criador.", 1, 0 )
		lRet := .F.
	EndIf

Return lRet

/*/{Protheus.doc} VldRevisao
	Valida se o orçamento não tem revisão mais recente
	(só a última revisão pode ser estornada)

	@type static function

	@author igor.seberino

	@since 25/11/2026

	@param cCod, character, Código do orçamento
	@param cRev, character, Revisão posicionada

	@return logical, .T. se é a revisão mais recente
/*/
Static Function VldRevisao( cCod as character, cRev as character ) as logical

	Local cQuery    := U_QuerySet( "ZB4", { "ZB4_REV" }, { { "ZB4_COD = ", cCod }, { "ZB4_REV > ", cRev } } ) as character
	Local cAliasQry := MPSysOpenQuery( cQuery ) as character
	Local lRet      := (cAliasQry)->( EoF() ) as logical

	If !lRet
		Help( , , "ZORCA05", , "Orçamento possui revisao mais recente", 1, 0 )
	EndIf

	(cAliasQry)->( dbCloseArea() )

Return lRet

/*/{Protheus.doc} ConfAprov
	Confirma a aprovação/reprovação. Reprovar exige observação.

	@type static function

	@author igor.seberino

	@since 26/11/2026

	@param nOpcao, numeric, 1 = Aprovar, 2 = Reprovar
	@param cObs, character, Observação digitada
	@param oModal, object, Diálogo fechado quando a confirmação é válida

	@return numeric, nOpcao se confirmou, 0 se não
/*/
Static Function ConfAprov( nOpcao as numeric, cObs as character, oModal as object ) as numeric

	Local nRet := 0 as numeric

	If nOpcao == 2 .And. Empty( AllTrim( cObs ) )
		Help( , , "ZORCA05", , "Reprovar exige observação", 1, 0 )
	Else
		nRet := nOpcao
		oModal:DeActivate()
	EndIf

Return nRet

/*/{Protheus.doc} ConfEstorno
	Confirma o estorno. Estornar exige observação.

	@type static function

	@author igor.seberino

	@since 26/11/2026

	@param cObs, character, Observação digitada
	@param oModal, object, Diálogo fechado quando a confirmação é válida

	@return numeric, 2 se confirmou, 0 se não
/*/
Static Function ConfEstorno( cObs as character, oModal as object ) as numeric

	Local nRet := 0 as numeric

	If Empty( AllTrim( cObs ) )
		Help( , , "ZORCA05", , "Estornar exige observação", 1, 0 )
	Else
		nRet := 2
		oModal:DeActivate()
	EndIf

Return nRet

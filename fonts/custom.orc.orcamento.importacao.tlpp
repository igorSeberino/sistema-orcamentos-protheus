#include "totvs.ch"
#include "fwmvcdef.ch"
#include "custom.orc.th"

namespace custom.orc.orcamento.importacao
using namespace custom.orc.utils

/*/{Protheus.doc} ZORCA06
	Importação de orçamento a partir de CSV

	@type user function

	@author igor.seberino

	@since 06/11/2026
/*/
User Function ZORCA06()

	Local cPath  := "" as character
	Local aPergs := {} as array
	Local aRet   := {} as array
	Local oFile  as object

	// Recebe o caminho do arquivo
	cPath := tFileDialog( "Arquivos CSV (*.csv)|*.csv", "Selecione o arquivo de importação", , , .F. )

	If Empty(cPath)
		Help( , , "ZORCA06", , "Nenhum arquivo selecionado.", 1, 0 )
		Return
	EndIf

	// Recebe o objeto do arquivo
	oFile := FWFileReader():New(cPath)

	If !oFile:Open()
		Help( , , "ZORCA06", , "Não foi possível abrir o arquivo " + cPath, 1, 0 )
		Return
	EndIf

	// Define campos pedidos ao usuário para inclusão em ZB4
	/*nTipo (1=Campo de Digitação(Get)), Texto na tela, Valor Inicial, Picture(Mask), Validação, F3, When(Editável), Largura, Obrigatório*/
	aAdd( aPergs, { 1, "Cliente"         , Space(TamSX3("ZB4_CLIENT")[1])   , ""        , "", "SA1", "", 50, .T. } )
	aAdd( aPergs, { 1, "Loja"            , Space(TamSX3("ZB4_LOJA")[1])     , ""        , "", ""   , "", 20, .T. } )
	aAdd( aPergs, { 1, "Título"          , Space(TamSX3("ZB4_TITULO")[1])   , ""        , "", ""   , "", 90, .T. } )
	aAdd( aPergs, { 1, "Horas/Dia"       , "08:30", "99:99", "", ""   , "", 30, .T. } )
	aAdd( aPergs, { 1, "Ticket"          , Space(TamSX3("ZB4_TICKET")[1])   , ""        , "", ""   , "", 50, .F. } )
	aAdd( aPergs, { 1, "Task"            , Space(TamSX3("ZB4_TASK")[1])     , ""        , "", ""   , "", 50, .F. } )
	aAdd( aPergs, { 1, "Definição padrão", Space(TamSX3("ZB5_DEFIN")[1])    , ""        , "", "ZB2", "", 20, .T. } )

	// Tenta abrir uma janela para preenchimento de campos da ZB4
	If !ParamBox( aPergs, "Importação de orçamento", @aRet, , , , , , , , .F. )
		oFile:Close()
		Return
	EndIf

	Importar( cPath, aRet, oFile )

Return

/*/{Protheus.doc} Importar
	Lê o CSV e grava o orçamento pelo modelo do ZORCA04, sem tela

	@type static function

	@author igor.seberino

	@since 12/11/2026

	@param cPath, character, Caminho do CSV
	@param aRet, array, Respostas do ParamBox
	@param oFile, object, Arquivo já aberto (FWFileReader); é fechado aqui
/*/
Static Function Importar( cPath as character, aRet as array, oFile as object )

	Local oModel  := FWLoadModel(NZORCA04 + ".U_ZORCA04") as object
	Local oZB5    as object
	Local oZB6    as object
	Local cLinha  as character
	Local cItem   := "" as character
	Local cDefin  as character
	Local aCol    as array
	Local aLog    := {} as array
	Local nLinha  := 0 as numeric
	Local nItens  := 0 as numeric
	Local nAtiv   := 0 as numeric
	Local lItemOk := .F. as logical
	Local lOk     as logical

	oModel:SetOperation(MODEL_OPERATION_INSERT)

	If !oModel:Activate()
		Help( , , "ZORCA06", , "Ocorreu um erro inesperado.", 1, 0 )
		oFile:Close()
		Return
	EndIf

	oZB5 := oModel:GetModel("ZB5DETAIL")
	oZB6 := oModel:GetModel("ZB6DETAIL")

	// Cabeçalho (ZB4) com os dados do ParamBox - Horas/Dia antes das atividades
	lOk := SetCampo( oModel, "ZB4MASTER", "ZB4_CLIENT", aRet[1], 0, aLog ) .And. ;
		SetCampo( oModel, "ZB4MASTER", "ZB4_LOJA"  , aRet[2], 0, aLog ) .And. ;
		SetCampo( oModel, "ZB4MASTER", "ZB4_TITULO", aRet[3], 0, aLog ) .And. ;
		SetCampo( oModel, "ZB4MASTER", "ZB4_HRDIA" , aRet[4], 0, aLog ) .And. ;
		SetCampo( oModel, "ZB4MASTER", "ZB4_TICKET", aRet[5], 0, aLog ) .And. ;
		SetCampo( oModel, "ZB4MASTER", "ZB4_TASK"  , aRet[6], 0, aLog )

	If !lOk
		oFile:Close()
		oModel:DeActivate()
		MostraLog(aLog)
		Return
	EndIf

	While oFile:HasLine()

		cLinha := oFile:GetLine()
		nLinha++

		// Linha 1 = cabeçalho do CSV. Linha vazia = fim de arquivo do Excel
		If nLinha == 1 .Or. Empty(cLinha)
			Loop
		EndIf

		aCol := StrTokArr2( cLinha, ";", .T. )

		If Len(aCol) < 10
			aAdd( aLog, TxtLinha(nLinha) + "quantidade de colunas inválida (esperado 10)." )
			Loop
		EndIf

		Do Case

		Case aCol[1] == "I"

			// A 1ª linha da grid já existe vazia no Activate
			If nItens > 0
				oZB5:AddLine()
			EndIf

			nItens++
			nAtiv  := 0
			cItem  := StrZero( Val(aCol[2]), 3 )

			If Empty(aCol[5])
				cDefin := aRet[7]
			Else
				cDefin := aCol[5]
			EndIf

			lItemOk := SetCampo( oModel, "ZB5DETAIL", "ZB5_ITEM"  , cItem  , nLinha, aLog ) .And. ;
				SetCampo( oModel, "ZB5DETAIL", "ZB5_DEMAND", aCol[3], nLinha, aLog ) .And. ;
				SetCampo( oModel, "ZB5DETAIL", "ZB5_DEFIN" , cDefin , nLinha, aLog ) .And. ;
				SetCampo( oModel, "ZB5DETAIL", "ZB5_AREA"  , aCol[6], nLinha, aLog )

			If !lItemOk
				oZB5:DeleteLine()
			EndIf

		Case aCol[1] == "A"

			If !lItemOk
				aAdd( aLog, TxtLinha(nLinha) + "atividade ignorada, o item " + aCol[2] + " foi rejeitado." )

			ElseIf StrZero( Val(aCol[2]), 3 ) != cItem
				aAdd( aLog, TxtLinha(nLinha) + "atividade do item " + aCol[2] + ", mas o último item lido é " + cItem + "." )

			Else
				// ZB6 é filha da ZB5: a grid já está na linha do item atual
				If nAtiv > 0
					oZB6:AddLine()
				EndIf

				nAtiv++

				lOk := SetCampo( oModel, "ZB6DETAIL", "ZB6_SUB" , StrZero( Val(aCol[3]), 3 ), nLinha, aLog ) .And. ;
					SetCampo( oModel, "ZB6DETAIL", "ZB6_ATIV", aCol[4]         , nLinha, aLog ) .And. ;
					SetCampo( oModel, "ZB6DETAIL", "ZB6_DDOC", CsvNum(aCol[7]) , nLinha, aLog ) .And. ;
					SetCampo( oModel, "ZB6DETAIL", "ZB6_DDEV", CsvNum(aCol[8]) , nLinha, aLog ) .And. ;
					SetCampo( oModel, "ZB6DETAIL", "ZB6_DANA", CsvNum(aCol[9]) , nLinha, aLog ) .And. ;
					SetCampo( oModel, "ZB6DETAIL", "ZB6_DVAL", CsvNum(aCol[10]), nLinha, aLog )

				If !lOk
					oZB6:DeleteLine()
				EndIf
			EndIf

		Otherwise
			aAdd( aLog, TxtLinha(nLinha) + "tipo de linha inválido [" + aCol[1] + "], esperado I ou A." )

		EndCase

	EndDo

	oFile:Close()

	If oModel:VldData() .And. oModel:CommitData()
		aIns( aSize(aLog, Len(aLog) + 1), 1 )
		aLog[1] := "Orçamento gerado: " + oModel:GetValue("ZB4MASTER", "ZB4_COD") + "/" + oModel:GetValue("ZB4MASTER", "ZB4_REV")
	Else
		aAdd( aLog, "Orçamento NÃO gravado: " + ErroModel(oModel) )
	EndIf

	oModel:DeActivate()

	MostraLog(aLog)

Return

/*/{Protheus.doc} SetCampo
	SetValue no modelo; se a validação recusar, registra o motivo no log

	@type static function

	@author igor.seberino

	@since 12/11/2026

	@param oModel, object, Modelo ZORCA04M ativo
	@param cSubModel, character, Submodelo (ex.: ZB5DETAIL)
	@param cCampo, character, Campo
	@param xValor, variant, Valor gravado
	@param nLinha, numeric, Linha do CSV (0 = parâmetros do ParamBox)
	@param aLog, array, Log da importação (recebe o erro)

	@return logical, .T. se o valor foi aceito
/*/
Static Function SetCampo( oModel as object, cSubModel as character, cCampo as character, xValor, nLinha as numeric, aLog as array ) as logical

	Local lRet := .T. as logical

	If !(oModel:SetValue( cSubModel, cCampo, xValor ))
		aAdd( aLog, TxtLinha(nLinha) + AllTrim(cCampo) + " - " + ErroModel(oModel) )
		lRet := .F.
	EndIf

Return lRet

/*/{Protheus.doc} ErroModel
	Mensagem + solução do último erro do modelo

	@type static function

	@author igor.seberino

	@since 12/11/2026

	@param oModel, object, Modelo com erro

	@return character, Mensagem do erro
/*/
Static Function ErroModel( oModel as object ) as character

	Local aErro := oModel:GetErrorMessage() as array
	Local cMsg  := AllTrim( cValToChar(aErro[6]) ) as character

	If !Empty(aErro[7])
		cMsg += " (" + AllTrim( cValToChar(aErro[7]) ) + ")"
	EndIf

Return cMsg

/*/{Protheus.doc} CsvNum
	Converte número do CSV (decimal com vírgula) para numérico

	@type static function

	@author igor.seberino

	@since 12/11/2026

	@param cValor, character, Valor lido do CSV

	@return numeric, Valor convertido
/*/
Static Function CsvNum( cValor as character ) as numeric
Return Val( StrTran( AllTrim(cValor), ",", "." ) )

/*/{Protheus.doc} TxtLinha
	Prefixo do log: "Linha N: " ou "Parâmetros: " (nLinha = 0)

	@type static function

	@author igor.seberino

	@since 12/11/2026

	@param nLinha, numeric, Linha do CSV (0 = parâmetros do ParamBox)

	@return character, Prefixo da mensagem
/*/
Static Function TxtLinha( nLinha as numeric ) as character

	Local cTexto as character

	If nLinha == 0
		cTexto := "Parâmetros: "
	Else
		cTexto := "Linha " + cValToChar(nLinha) + ": "
	EndIf

Return cTexto

/*/{Protheus.doc} MostraLog
	Exibe o resultado da importação

	@type static function

	@author igor.seberino

	@since 12/11/2026

	@param aLog, array, Mensagens da importação
/*/
Static Function MostraLog( aLog as array )

	Local cTexto := "" as character
	Local nI     as numeric

	For nI := 1 To Len(aLog)
		cTexto += aLog[nI] + CRLF
	Next nI

	If Empty(cTexto)
		cTexto := "Nenhuma linha processada."
	EndIf

	Aviso( "ZORCA06 - Resultado da importação", cTexto, { "OK" }, 3 )

Return

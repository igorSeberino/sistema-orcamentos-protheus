#include "totvs.ch"
#include "fwmvcdef.ch"
#include "custom.orc.th"

namespace custom.orc.consulta.historico
using namespace custom.orc.utils

/*/{Protheus.doc} ZORCA07
	Consulta histórica com filtros

	@type user function

	@author igor.seberino

	@since 16/11/2026

	@param cDef, character, Definição inicial do filtro (opcional, vem do botão Atividades Similares)
/*/
User Function ZORCA07( cDef as character )

	Local oModal := FWDialogModal():New() as object
	Local oPanel := oModal:GetPanelMain() as object
	Local oGet as object

	Local oBrowseRes as object
	Local oBrowseDet as object

	Local aDetalhe := {} as array

	Local aResumo := {} as array
	Local aDetTodos := {} as array

	Local cArea    := Space( TamSX3("ZB5_AREA")[1] ) as character
	Local cCli     := Space( TamSX3("ZB4_CLIENT")[1] ) as character
	Local dDateIni := CtoD("") as date
	Local dDateFin := CtoD("") as date
	Local lAprov   := .F. as logical

	Local oCheck as object
	Local oFontTitle := TFont():New("Arial", , -20, , .T.) as object
	Local oFontSubt := TFont():New("Arial", , -16, , .T.) as object
	Local oFont := TFont():New("Arial", , -12) as object

	Local aButtons := {;
		{ , "Visualizar Cliente"  , { || ViewCliente( aDetalhe, oBrowseDet ) }           , , 1, .T., .F. }, ;
		{ , "Visualizar Orçamento", { || Visualizar( aDetalhe, oBrowseDet ) }, , 2, .T., .F. }, ;
		{ , "Exportar Excel", { || ExportExcel( aResumo, aDetTodos, cDef, cArea, cCli, dDateIni, dDateFin, lAprov ) }, , 3, .T., .F. } ;
		} as array

	If Empty(cDef)
		cDef := Space( TamSX3("ZB5_DEFIN")[1] )
	EndIf

	oModal:SetEscClose(.T.)
	oModal:SetSize(270, 550) // altura, largura
	oModal:CreateDialog()

	// Título e Linha
	TSay():New( 010, 010, { || "Consulta Histórica" }, oPanel, , oFontTitle, , , , .T., , , 100, 010 ) //Título
	TPanel():New( 025, 010, , oPanel, , , , , CLR_GRAY, 530, 1 )

	// Campo Definição
	TSay():New( 031, 010, { || "Definição" }, oPanel, , oFontSubt, , , , .T., , , 040, 010 )
	oGet := TGet():New( 030, 050, { |u| If( PCount() > 0, cDef := u, cDef ) }, oPanel, 025, 010, "@!", , , , oFont, , , .T. )
	oGet:cF3 := "ZB2"
	oGet:bValid := { ||( Empty(cDef) .Or. U_VldDefin( cDef ) ) .And. Pesquisar( cDef, cArea, cCli, dDateIni, dDateFin, lAprov, oBrowseRes, aResumo, oBrowseDet, aDetalhe, aDetTodos ) }

	// Campo Área
	TSay():New( 031, 085, { || "Área" }, oPanel, , oFontSubt, , , , .T., , , 020, 010 )
	oGet := TGet():New( 030, 105, { |u| If( PCount() > 0, cArea := u, cArea ) }, oPanel, 025, 010, "@!", , , , oFont, , , .T. )
	oGet:cF3 := "ZB1"
	oGet:bValid := { || ( Empty(cArea) .Or. U_VldArea( cArea ) ) .And. Pesquisar( cDef, cArea, cCli, dDateIni, dDateFin, lAprov, oBrowseRes, aResumo, oBrowseDet, aDetalhe, aDetTodos ) }

	// Campo Cliente
	TSay():New( 031, 140, { || "Cliente" }, oPanel, , oFontSubt, , , , .T., , , 030, 010 )
	oGet := TGet():New( 030, 170, { |u| If( PCount() > 0, cCli := u, cCli ) }, oPanel, 025, 010, "@!", , , , oFont, , , .T. )
	oGet:cF3 := "SA1"
	oGet:bValid := { || ( Empty(cCli) .Or. ExistCpo( "SA1", cCli ) ) .And. Pesquisar( cDef, cArea, cCli, dDateIni, dDateFin, lAprov, oBrowseRes, aResumo, oBrowseDet, aDetalhe, aDetTodos ) }

	// Campo Data Init
	TSay():New( 031, 210, { || "Período de" }, oPanel, , oFontSubt, , , , .T., , , 050, 010 )
	oGet := TGet():New( 030, 255, { |u| If( PCount() > 0, dDateIni := u, dDateIni ) }, oPanel, 050, 010, , , , , oFont, , , .T., , , , , , , , , , , , , , .T. )
	oGet:bValid := { || VldPeriodo( dDateIni, dDateFin ) .And. ( Pesquisar( cDef, cArea, cCli, dDateIni, dDateFin, lAprov, oBrowseRes, aResumo, oBrowseDet, aDetalhe, aDetTodos ), .T. ) }

	// Campo Data Fin
	TSay():New( 031, 305, { || "até" }, oPanel, , oFontSubt, , , , .T., , , 020, 010 )
	oGet := TGet():New( 030, 320, { |u| If( PCount() > 0, dDateFin := u, dDateFin ) }, oPanel, 050, 010, , , , , oFont, , , .T., , , , , , , , , , , , , , .T. )
	oGet:bValid := { || VldPeriodo( dDateIni, dDateFin ) .And. ( Pesquisar( cDef, cArea, cCli, dDateIni, dDateFin, lAprov, oBrowseRes, aResumo, oBrowseDet, aDetalhe, aDetTodos ), .T. ) }

	oCheck := TCheckBox():New( 033, 375, "Somente aprovados", { |u| If( PCount() > 0, lAprov := u, lAprov ) }, oPanel, 100, 010, , ;
		{ || Pesquisar( cDef, cArea, cCli, dDateIni, dDateFin, lAprov, oBrowseRes, aResumo, oBrowseDet, aDetalhe, aDetTodos ) }, oFontSubt, , , , , .T. )
	oCheck:SetCss( "QCheckBox::indicator { width: 24px; height: 24px; }" )

	// Botões da barra inferior
	oModal:addButtons( aButtons )
	oModal:AddCloseButton( Nil, "Fechar" )

	TSay():New( 128, 010, { || "Detalhe" }, oPanel, , oFontSubt, , , , .T., , , 100, 012 )
	oBrowseDet := Detalhe( oPanel, aDetalhe )

	TSay():New( 050, 010, { || "Resumo" }, oPanel, , oFontSubt, , , , .T., , , 100, 012 )
	oBrowseRes := Resumo( oPanel, aResumo, { || FiltraDetalhe( oBrowseRes, aResumo, oBrowseDet, aDetalhe, aDetTodos ) } )

	Pesquisar( cDef, cArea, cCli, dDateIni, dDateFin, lAprov, oBrowseRes, aResumo, oBrowseDet, aDetalhe, aDetTodos )

	oModal:Activate()

Return

/*/{Protheus.doc} Resumo
	Monta o browse de resumo (uma linha por definição)

	@type static function

	@author igor.seberino

	@since 16/11/2026

	@param oPanel, object, Painel onde o browse é criado
	@param aResumo, array, Dados do resumo
	@param bChange, codeblock, Executado ao trocar de linha (filtra o detalhe)

	@return object, Browse criado (FWBrowse)
/*/
Static Function Resumo( oPanel as object, aResumo as array, bChange as codeblock ) as object

	Local oPanelRes := TPanel():New( 062, 010, , oPanel, , , , , , 530, 060 ) as object
	Local oBrowseRes := FWBrowse():New( oPanelRes ) as object

	oBrowseRes:SetDataArray()
	oBrowseRes:SetArray( aResumo )
	oBrowseRes:DisableConfig()
	oBrowseRes:DisableReport()
	oBrowseRes:SetColumns( { ;
		U_NovaCol( "Definição", { || aResumo[oBrowseRes:At(), 1] }, "C", 30, 0, "@!" ), ;
		U_NovaCol( "Itens",     { || aResumo[oBrowseRes:At(), 2] }, "N", 5,  0, "@E 99999" ), ;
		U_NovaCol( "Média",     { || aResumo[oBrowseRes:At(), 3] }, "C", 10, 2, "", CONTROL_ALIGN_RIGHT ), ;
		U_NovaCol( "Mín",       { || aResumo[oBrowseRes:At(), 4] }, "C", 10, 2, "", CONTROL_ALIGN_RIGHT ), ;
		U_NovaCol( "Máx",       { || aResumo[oBrowseRes:At(), 5] }, "C", 10, 2, "", CONTROL_ALIGN_RIGHT ), ;
		U_NovaCol( "Doc %",     { || aResumo[oBrowseRes:At(), 6] }, "N", 6,  2, "@E 999.99", CONTROL_ALIGN_RIGHT ), ;
		U_NovaCol( "Dev %",     { || aResumo[oBrowseRes:At(), 7] }, "N", 6,  2, "@E 999.99", CONTROL_ALIGN_RIGHT ), ;
		U_NovaCol( "Anál %",    { || aResumo[oBrowseRes:At(), 8] }, "N", 6,  2, "@E 999.99", CONTROL_ALIGN_RIGHT ), ;
		U_NovaCol( "Vald %",    { || aResumo[oBrowseRes:At(), 9] }, "N", 6,  2, "@E 999.99", CONTROL_ALIGN_RIGHT ) } )
	oBrowseRes:SetChange( bChange )
	oBrowseRes:Activate()

Return oBrowseRes

/*/{Protheus.doc} Detalhe
	Monta o browse de detalhe (itens da definição selecionada)

	@type static function

	@author igor.seberino

	@since 16/11/2026

	@param oPanel, object, Painel onde o browse é criado
	@param aDetalhe, array, Dados do detalhe

	@return object, Browse criado (FWBrowse)
/*/
Static Function Detalhe( oPanel as object, aDetalhe as array ) as object

	Local oPanelDet := TPanel():New( 140, 010, , oPanel, , , , , , 530, 100 ) as object
	Local oBrowseDet := FWBrowse():New( oPanelDet ) as object

	oBrowseDet:SetDataArray()
	oBrowseDet:SetArray( aDetalhe )
	oBrowseDet:DisableConfig()
	oBrowseDet:DisableReport()
	oBrowseDet:SetColumns( { ;
		U_NovaCol( "Orçamento", { || aDetalhe[oBrowseDet:At(), 1] }, "C", 10, 0, "@!" ), ;
		U_NovaCol( "Cliente",   { || aDetalhe[oBrowseDet:At(), 2] }, "C", 30, 0, "@!" ), ;
		U_NovaCol( "Ticket",    { || aDetalhe[oBrowseDet:At(), 3] }, "C", 15, 0, "@!" ), ;
		U_NovaCol( "Demanda",   { || aDetalhe[oBrowseDet:At(), 4] }, "C", 50, 0, "" ), ;
		U_NovaCol( "Horas",     { || aDetalhe[oBrowseDet:At(), 5] }, "C", 10, 2, "" ) } )
	oBrowseDet:Activate()

Return oBrowseDet

/*/{Protheus.doc} Pesquisar
	Executa as queries de resumo e detalhe com os filtros da tela
	e atualiza os dois browses

	@type static function

	@author igor.seberino

	@since 16/11/2026

	@param cDef, character, Filtro de definição
	@param cArea, character, Filtro de área
	@param cCli, character, Filtro de cliente
	@param dDateIni, date, Data inicial
	@param dDateFin, date, Data final
	@param lAprov, logical, Somente aprovados
	@param oBrowseRes, object, Browse de resumo
	@param aResumo, array, Dados do resumo (preenchido aqui)
	@param oBrowseDet, object, Browse de detalhe
	@param aDetalhe, array, Detalhe da definição selecionada
	@param aDetTodos, array, Detalhe de todas as definições (preenchido aqui)

	@return logical, sempre .T. (usado em bValid)
/*/
Static Function Pesquisar( cDef as character, cArea as character, cCli as character, dDateIni as date, dDateFin as date, lAprov as logical, oBrowseRes as object, aResumo as array, oBrowseDet as object, aDetalhe as array, aDetTodos as array ) as logical

	Local aArea   := GetArea() as array
	Local aParams := {} as array
	Local cFiltro as character
	Local cAlias  as character

	cFiltro := Filtros( cDef, cArea, cCli, dDateIni, dDateFin, lAprov, aParams )

	//Resumo
	aSize( aResumo, 0 )
	cAlias := MPSysOpenQuery( QryResumo( cFiltro, aParams ) )

	While !(cAlias)->(EoF())
		aAdd( aResumo, { (cAlias)->ZB2_COD + " " + (cAlias)->ZB2_DESC, ;
			(cAlias)->ITENS, U_NumToHours((cAlias)->MEDIA), ;
			U_NumToHours((cAlias)->MINIMO), U_NumToHours((cAlias)->MAXIMO), ;
			(cAlias)->PDOC, (cAlias)->PDEV, (cAlias)->PANA, (cAlias)->PVAL, ;
			(cAlias)->ZB2_COD } )
		(cAlias)->( DbSkip() )
	EndDo
	(cAlias)->(DbCloseArea())

	// Detalhe
	aSize( aDetTodos, 0 )
	cAlias := MPSysOpenQuery( QryDetalhe( cFiltro, aParams ) )

	While !(cAlias)->(EoF())
		aAdd( aDetTodos, { (cAlias)->ZB4_COD + "/" + (cAlias)->ZB4_REV, ;
			(cAlias)->ZB4_CLIENT + "/" + (cAlias)->ZB4_LOJA, ;
			(cAlias)->ZB4_TICKET, ;
			(cAlias)->ZB5_DEMAND, ;
			U_NumToHours((cAlias)->ZB5_TTHRNM), ;
			(cAlias)->ZB5_DEFIN, ;
			(cAlias)->ZB5_TTHRNM } )
		(cAlias)->(DbSkip())
	EndDo
	(cAlias)->(DbCloseArea())

	oBrowseRes:SetArray( aResumo )
	oBrowseRes:Refresh( .T. )

	FiltraDetalhe( oBrowseRes, aResumo, oBrowseDet, aDetalhe, aDetTodos )

	RestArea( aArea )

Return .T.

/*/{Protheus.doc} Filtros
	Monta o FROM/JOIN/WHERE comum às queries de resumo e detalhe,
	com parâmetros "?" (sem concatenar valores)

	@type static function

	@author igor.seberino

	@since 17/11/2026

	@param cDef, character, Filtro de definição
	@param cArea, character, Filtro de área
	@param cCli, character, Filtro de cliente
	@param dDateIni, date, Data inicial
	@param dDateFin, date, Data final
	@param lAprov, logical, Somente aprovados
	@param aParams, array, Valores dos "?" na ordem (preenchido aqui)

	@return character, Trecho FROM ... WHERE da query
/*/
Static Function Filtros( cDef as character, cArea as character, cCli as character, dDateIni as date, dDateFin as date, lAprov as logical, aParams as array ) as character

	Local cFiltro as character

	cFiltro := " FROM " + RetSQLName("ZB5") + " ZB5 "

	cFiltro += " INNER JOIN " + RetSQLName("ZB2") + " ZB2 "
	cFiltro += "    ON ZB2.ZB2_FILIAL = ? "
	cFiltro += "   AND ZB2.ZB2_COD    = ZB5.ZB5_DEFIN "
	cFiltro += "   AND ZB2.D_E_L_E_T_ = ' ' "

	cFiltro += " INNER JOIN " + RetSQLName("ZB4") + " ZB4 "
	cFiltro += "    ON ZB4.ZB4_FILIAL = ZB5.ZB5_FILIAL "
	cFiltro += "   AND ZB4.ZB4_COD    = ZB5.ZB5_COD "
	cFiltro += "   AND ZB4.ZB4_REV    = ZB5.ZB5_REV "
	cFiltro += "   AND ZB4.D_E_L_E_T_ = ' ' "

	cFiltro += " INNER JOIN ( SELECT ZB6_FILIAL, ZB6_COD, ZB6_REV, ZB6_ITEM, "
	cFiltro += "                     SUM(ZB6_HDOCNM) HDOC, SUM(ZB6_HDEVNM) HDEV, "
	cFiltro += "                     SUM(ZB6_HANANM) HANA, SUM(ZB6_HVALNM) HVAL "
	cFiltro += "                FROM " + RetSQLName("ZB6")
	cFiltro += "               WHERE D_E_L_E_T_ = ' ' "
	cFiltro += "               GROUP BY ZB6_FILIAL, ZB6_COD, ZB6_REV, ZB6_ITEM ) ZB6T "
	cFiltro += "    ON ZB6T.ZB6_FILIAL = ZB5.ZB5_FILIAL "
	cFiltro += "   AND ZB6T.ZB6_COD    = ZB5.ZB5_COD "
	cFiltro += "   AND ZB6T.ZB6_REV    = ZB5.ZB5_REV "
	cFiltro += "   AND ZB6T.ZB6_ITEM   = ZB5.ZB5_ITEM "

	cFiltro += " WHERE ZB5.D_E_L_E_T_ = ' ' "
	cFiltro += "   AND ZB5.ZB5_FILIAL = ? "

	aAdd( aParams, xFilial("ZB2") )
	aAdd( aParams, xFilial("ZB5") )

	If !Empty( cDef )
		cFiltro += " AND ZB5.ZB5_DEFIN = ? "
		aAdd( aParams, cDef )
	EndIf

	If !Empty( cArea )
		cFiltro += " AND ZB5.ZB5_AREA = ? "
		aAdd( aParams, cArea )
	EndIf

	If !Empty( cCli )
		cFiltro += " AND ZB4.ZB4_CLIENT = ? "
		aAdd( aParams, cCli )
	EndIf

	If !Empty( dDateIni )
		cFiltro += " AND ZB4.ZB4_DATA >= ? "
		aAdd( aParams, dDateIni )
	EndIf

	If !Empty( dDateFin )
		cFiltro += " AND ZB4.ZB4_DATA <= ? "
		aAdd( aParams, dDateFin )
	EndIf

	If lAprov
		cFiltro += " AND ZB4.ZB4_STATUS = ? "
		aAdd( aParams, STATUS_APROVADO )
	EndIf

Return cFiltro

/*/{Protheus.doc} QryDetalhe
	Query do detalhe: um registro por item de orçamento (ZB5)

	@type static function

	@author igor.seberino

	@since 17/11/2026

	@param cFiltro, character, Trecho FROM ... WHERE (Filtros)
	@param aParams, array, Valores dos "?"

	@return character, Query pronta
/*/
Static Function QryDetalhe( cFiltro as character, aParams as array ) as character

	Local cQuery as character

	cQuery := " SELECT ZB4.ZB4_COD, ZB4.ZB4_REV, ZB4.ZB4_CLIENT, ZB4.ZB4_LOJA, ZB4.ZB4_TICKET, "
	cQuery += "        ZB5.ZB5_DEFIN, ZB5.ZB5_ITEM, ZB5.ZB5_DEMAND, ZB5.ZB5_TTHRNM "
	cQuery += cFiltro
	cQuery += " ORDER BY ZB5.ZB5_DEFIN, ZB4.ZB4_COD, ZB4.ZB4_REV, ZB5.ZB5_ITEM "

Return PreparaQry( cQuery, aParams )

/*/{Protheus.doc} QryResumo
	Query do resumo: um registro por definição, com média,
	mínimo, máximo e percentual de cada fase

	@type static function

	@author igor.seberino

	@since 17/11/2026

	@param cFiltro, character, Trecho FROM ... WHERE (Filtros)
	@param aParams, array, Valores dos "?"

	@return character, Query pronta
/*/
Static Function QryResumo( cFiltro as character, aParams as array ) as character

	Local cQuery as character

	cQuery := " SELECT ZB2.ZB2_COD, ZB2.ZB2_DESC, "
	cQuery += "        COUNT(*) ITENS, "
	cQuery += "        AVG(ZB5.ZB5_TTHRNM) MEDIA, MIN(ZB5.ZB5_TTHRNM) MINIMO, MAX(ZB5.ZB5_TTHRNM) MAXIMO, "
	cQuery += "        SUM(ZB6T.HDOC) * 100 / NULLIF(SUM(ZB5.ZB5_TTHRNM), 0) PDOC, "
	cQuery += "        SUM(ZB6T.HDEV) * 100 / NULLIF(SUM(ZB5.ZB5_TTHRNM), 0) PDEV, "
	cQuery += "        SUM(ZB6T.HANA) * 100 / NULLIF(SUM(ZB5.ZB5_TTHRNM), 0) PANA, "
	cQuery += "        SUM(ZB6T.HVAL) * 100 / NULLIF(SUM(ZB5.ZB5_TTHRNM), 0) PVAL "
	cQuery += cFiltro
	cQuery += " GROUP BY ZB2.ZB2_COD, ZB2.ZB2_DESC "
	cQuery += " ORDER BY ZB2.ZB2_COD "

Return PreparaQry( cQuery, aParams )

/*/{Protheus.doc} PreparaQry
	Preenche os "?" da query com os parâmetros (FWPreparedStatement)

	@type static function

	@author igor.seberino

	@since 27/11/2026

	@param cQuery, character, Query com "?"
	@param aParams, array, Valores na ordem dos "?" (data ou caractere)

	@return character, Query com os parâmetros aplicados
/*/
Static Function PreparaQry( cQuery as character, aParams as array ) as character

	Local oStmt := FWPreparedStatement():New() as object
	Local nI    as integer

	oStmt:SetQuery( cQuery )

	For nI := 1 To Len( aParams )
		If ValType( aParams[nI] ) == "D"
			oStmt:SetDate( nI, aParams[nI] )
		Else
			oStmt:SetString( nI, aParams[nI] )
		EndIf
	Next nI

Return oStmt:GetFixQuery()

/*/{Protheus.doc} FiltraDetalhe
	Filtra o detalhe pela definição selecionada no resumo

	@type static function

	@author igor.seberino

	@since 17/11/2026

	@param oBrowseRes, object, Browse de resumo
	@param aResumo, array, Dados do resumo
	@param oBrowseDet, object, Browse de detalhe
	@param aDetalhe, array, Detalhe filtrado (preenchido aqui)
	@param aDetTodos, array, Detalhe de todas as definições

	@return logical, sempre .T.
/*/
Static Function FiltraDetalhe( oBrowseRes as object, aResumo as array, oBrowseDet as object, aDetalhe as array, aDetTodos as array ) as logical

	Local cCod as character
	Local nI   as integer

	aSize( aDetalhe, 0 )

	If !Empty( aResumo ) .And. oBrowseRes:At() > 0

		cCod := aResumo[ oBrowseRes:At() ][10]

		For nI := 1 to Len( aDetTodos )

			If aDetTodos[nI][6] == cCod
				aAdd( aDetalhe, aDetTodos[nI] )
			EndIf

		Next nI

	EndIf

	oBrowseDet:SetArray( aDetalhe )
	oBrowseDet:Refresh( .T. )

Return .T.

/*/{Protheus.doc} Visualizar
	Abre o orçamento da linha selecionada no detalhe (ZORCA04 em visualização)

	@type static function

	@author igor.seberino

	@since 17/11/2026

	@param aDetalhe, array, Detalhe filtrado
	@param oBrowseDet, object, Browse de detalhe
/*/
Static Function Visualizar( aDetalhe as array, oBrowseDet as object )

	Local aArea   := GetArea() as array
	Local aFields as array
	Local cChave  as character

	If Empty(aDetalhe) .Or. oBrowseDet:At() < 1
		Help( , , "HELP", , "Nenhum orçamento para visualizar.", 1, 0 )
		Return
	EndIf

	aFields := StrTokArr2( aDetalhe[oBrowseDet:At(), 1], "/", .T. )
	cChave := FWxFilial("ZB4") + aFields[1] + aFields[2]

	DbSelectArea("ZB4")
	ZB4->(DbSetOrder(1))
	ZB4->(DbSeek(cChave))

	FWExecView("Visualizar", FormatStr("VIEWDEF.%c.ZORCA04", NZORCA04), MODEL_OPERATION_VIEW)

	RestArea(aArea)

Return

/*/{Protheus.doc} ExportExcel
	Gera a planilha (abas Resumo e Detalhe) e copia para a
	pasta temporária da máquina do usuário

	@type static function

	@author igor.seberino

	@since 26/11/2026

	@param aResumo, array, Dados do resumo
	@param aDetTodos, array, Detalhe de todas as definições
	@param cDef, character, Filtro de definição
	@param cArea, character, Filtro de área
	@param cCli, character, Filtro de cliente
	@param dDateIni, date, Data inicial
	@param dDateFin, date, Data final
	@param lAprov, logical, Somente aprovados
/*/
Static Function ExportExcel( aResumo as array, aDetTodos as array, cDef as character, cArea as character, cCli as character, dDateIni as date, dDateFin as date, lAprov as logical )

	Local oXlsx    := FwPrinterXlsx():New() as object
	Local cFiltros := DescFiltros( cDef, cArea, cCli, dDateIni, dDateFin, lAprov ) as character
	Local cArqRel  := "\spool\" + StrTran( NomeArquivo( cDef ), ".xlsx", ".rel" ) as character
	Local cArqXlsx := StrTran( cArqRel, ".rel", ".xlsx" ) as character
	Local cFonte   := FwPrinterFont():getFromName( "Arial" ) as character
	Local cHorEsq  := "1" as character   // horizontal: 1 = esquerda (FwXlsxHorizontalAlignment)
	Local cVertCen := "3" as character   // vertical:   3 = centro   (FwXlsxVerticalAlignment)
	Local aCab     as array
	Local aLinha   as array
	Local nI       as integer
	Local nC       as integer
	Local nLin     as integer

	If Empty( aDetTodos )
		Help( , , "HELP", , "Não há dados para exportar.", 1, 0 )
		Return
	EndIf

	If !oXlsx:Activate( cArqRel )
		Help( , , "HELP", , "Não foi possível preparar o arquivo " + cArqRel, 1, 0 )
		Return
	EndIf

	// Aba Resumo: uma linha por Definição
	oXlsx:AddSheet( "Resumo" )
	oXlsx:SetColumnsWidth( 1, 9, 14 )

	// Linha 1: título com os filtros
	oXlsx:SetFont( cFonte, 12, .F., .T., .F. )
	oXlsx:SetCellsFormat( cHorEsq, cVertCen, .F., 0, "000000", "FFFFFF", "" )
	oXlsx:SetText( 1, 1, "Consulta Histórica - Resumo | " + cFiltros )

	// Linha 2: cabeçalho azul com texto branco
	aCab := { "Def.", "Itens", "Média Hrs", "Min. Hrs", "Max. Hrs", "Documentação", "Dev", "Análise", "Valor" }
	oXlsx:SetFont( cFonte, 10, .F., .T., .F. )
	oXlsx:SetCellsFormat( cHorEsq, cVertCen, .F., 0, "E9EEF4", "1F4E79", "" )
	For nC := 1 To Len( aCab )
		oXlsx:SetText( 2, nC, aCab[nC] )
	Next nC

	// Dados a partir da linha 3, alternando a cor de fundo
	oXlsx:SetFont( cFonte, 10, .F., .F., .F. )
	For nI := 1 To Len( aResumo )
		nLin := nI + 2

		If nI % 2 == 0
			oXlsx:SetCellsFormat( cHorEsq, cVertCen, .F., 0, "000000", "E9EEF4", "" )
		Else
			oXlsx:SetCellsFormat( cHorEsq, cVertCen, .F., 0, "000000", "FFFFFF", "" )
		EndIf

		aLinha := { AllTrim( aResumo[nI,1] ), aResumo[nI,2], aResumo[nI,3], aResumo[nI,4], aResumo[nI,5], ;
			AllTrim( Transform( aResumo[nI,6], "@E 999.99" ) ) + " %", ;
			AllTrim( Transform( aResumo[nI,7], "@E 999.99" ) ) + " %", ;
			AllTrim( Transform( aResumo[nI,8], "@E 999.99" ) ) + " %", ;
			AllTrim( Transform( aResumo[nI,9], "@E 999.99" ) ) + " %" }

		For nC := 1 To Len( aLinha )
			If ValType( aLinha[nC] ) == "N"
				oXlsx:SetNumber( nLin, nC, aLinha[nC] )
			Else
				oXlsx:SetText( nLin, nC, aLinha[nC] )
			EndIf
		Next nC
	Next nI

	// Aba Detalhe: uma linha por item de orçamento
	oXlsx:AddSheet( "Detalhe" )
	oXlsx:SetColumnsWidth( 1, 4, 16 )   // Def., Orçamento, Cliente, Ticket
	oXlsx:SetColumnsWidth( 5, 5, 60 )   // Demanda
	oXlsx:SetColumnsWidth( 6, 6, 10 )   // Horas

	// Linha 1: título com os filtros
	oXlsx:SetFont( cFonte, 12, .F., .T., .F. )
	oXlsx:SetCellsFormat( cHorEsq, cVertCen, .F., 0, "000000", "FFFFFF", "" )
	oXlsx:SetText( 1, 1, "Consulta Histórica - Detalhe | " + cFiltros )

	// Linha 2: cabeçalho azul com texto branco
	aCab := { "Def.", "Orçamento", "Cliente", "Ticket", "Demanda", "Horas" }
	oXlsx:SetFont( cFonte, 10, .F., .T., .F. )
	oXlsx:SetCellsFormat( cHorEsq, cVertCen, .F., 0, "E9EEF4", "1F4E79", "" )
	For nC := 1 To Len( aCab )
		oXlsx:SetText( 2, nC, aCab[nC] )
	Next nC

	// Dados a partir da linha 3, alternando a cor de fundo
	oXlsx:SetFont( cFonte, 10, .F., .F., .F. )
	For nI := 1 To Len( aDetTodos )
		nLin := nI + 2

		If nI % 2 == 0
			oXlsx:SetCellsFormat( cHorEsq, cVertCen, .F., 0, "000000", "E9EEF4", "" )
		Else
			oXlsx:SetCellsFormat( cHorEsq, cVertCen, .F., 0, "000000", "FFFFFF", "" )
		EndIf

		aLinha := { AllTrim( aDetTodos[nI,6] ), AllTrim( aDetTodos[nI,1] ), AllTrim( aDetTodos[nI,2] ), ;
			AllTrim( aDetTodos[nI,3] ), AllTrim( aDetTodos[nI,4] ), aDetTodos[nI,5] }

		For nC := 1 To Len( aLinha )
			oXlsx:SetText( nLin, nC, aLinha[nC] )
		Next nC
	Next nI

	oXlsx:toXlsx()
	oXlsx:EraseBaseFile()   // apaga o .rel intermediário
	oXlsx:DeActivate()

	If File( cArqXlsx )
		CpyS2T( cArqXlsx, GetTempPath() )   // copia do servidor para a máquina do usuário
	Else
		Help( , , "HELP", , "Planilha não foi gerada: " + cArqXlsx, 1, 0 )
	EndIf

Return

/*/{Protheus.doc} DescFiltros
	Monta o texto dos filtros usados, para o título das tabelas da planilha

	@type static function

	@author igor.seberino

	@since 25/11/2026

	@param cDef, character, Filtro de definição
	@param cArea, character, Filtro de área
	@param cCli, character, Filtro de cliente
	@param dDateIni, date, Data inicial
	@param dDateFin, date, Data final
	@param lAprov, logical, Somente aprovados

	@return character, Texto dos filtros
/*/
Static Function DescFiltros( cDef as character, cArea as character, cCli as character, dDateIni as date, dDateFin as date, lAprov as logical ) as character

	Local cTexto as character
	Local cIni   := "..." as character
	Local cFin   := "..." as character

	If Empty(cDef)
		cTexto := "Definição: todas"
	Else
		cTexto := "Definição: " + AllTrim( cDef )
	EndIf

	If Empty(cArea)
		cTexto += " | Área: todas"
	Else
		cTexto += " | Área: " + AllTrim( cArea )
	EndIf

	If Empty(cCli)
		cTexto += " | Cliente: todos"
	Else
		cTexto += " | Cliente: " + AllTrim( cCli )
	EndIf

	If !Empty( dDateIni ) .Or. !Empty( dDateFin )

		If !Empty( dDateIni )
			cIni := DtoC( dDateIni )
		EndIf

		If !Empty( dDateFin )
			cFin := DtoC( dDateFin )
		EndIf

		cTexto += " | Período: " + cIni + " a " + cFin
	EndIf

	If lAprov
		cTexto += " | Somente aprovados"
	EndIf

Return cTexto

/*/{Protheus.doc} NomeArquivo
	Monta o nome do arquivo com a Definição e a data da geração
	Ex.: consulta_historica_def002_20261125.xlsx

	@type static function

	@author igor.seberino

	@since 25/11/2026

	@param cDef, character, Filtro de definição

	@return character, Nome do arquivo .xlsx
/*/
Static Function NomeArquivo( cDef as character ) as character

	Local cNome := "consulta_historica" as character

	If !Empty( cDef )
		cNome += "_def" + AllTrim( cDef )
	EndIf

	cNome += "_" + DtoS( Date() ) + ".xlsx"

Return cNome

/*/{Protheus.doc} VldPeriodo
	Valida se a data inicial não é maior que a final.

	@type static function

	@author igor.seberino

	@since 26/11/2026

	@param dIni, date, Data inicial
	@param dFin, date, Data final

	@return logical, .T. se o período é válido
/*/
Static Function VldPeriodo( dIni as date, dFin as date ) as logical

	Local lOk := .T. as logical

	If !Empty( dIni ) .And. !Empty( dFin ) .And. dIni > dFin
		Help( , , "HELP", , "Data inicial maior que a final", 1, 0 )
		lOk := .F.
	EndIf

Return lOk

/*/{Protheus.doc} ViewCliente
	Abre a visualização do cliente da linha selecionada no detalhe

	@type static function

	@author igor.seberino

	@since 27/11/2026

	@param aDetalhe, array, Detalhe filtrado
	@param oBrowseDet, object, Browse de detalhe
/*/
Static Function ViewCliente( aDetalhe as array, oBrowseDet as object )

	Local aArea := GetArea() as array
	Local aCliente := StrTokArr2( aDetalhe[oBrowseDet:At(), 2], "/", .T. )

	U_ViewCliente( aCliente[1], aCliente[2] )

	RestArea( aArea )
	
Return 

#include "totvs.ch"
#include "fwmvcdef.ch"
#include "custom.orc.th"

namespace custom.orc.cadastro.aprovadores
using namespace custom.orc.utils

/*/{Protheus.doc} ZORCA03
	Cadastro de Aprovadores (ZB3) - tela browse

	@type function

	@author igor.seberino
	
	@since 23/10/2026
/*/
User Function ZORCA03()

	Local oBrowse := FWMBrowse():New()

	oBrowse:SetAlias("ZB3")
	oBrowse:SetDescription("Cadastro de Aprovadores")

	// oBrowse:AddLegend(/* Campo = Valor */,/* Cor */,/* Legenda */)
	oBrowse:AddLegend("ZB3_ATIVO == '" + ATIVO_SIM + "'", "GREEN", "Ativa")
	oBrowse:AddLegend("ZB3_ATIVO == '" + ATIVO_NAO + "'", "RED", "Inativa")

	oBrowse:Activate()

Return

/*/{Protheus.doc} ModelDef
	Regras de negocio e estrutura de dados do cadastro de aprovadores (ZB3)

	@type user function

	@author igor.seberino

	@since 23/10/2026

	@return object, o model MVC (MPFormModel)
/*/
User Function ModelDef()
	Local oModel   := MPFormModel():New("ZORCA03M", /*bPre*/, { |oModel| VldExclusao(oModel) })
	Local oStruZB3 := FWFormStruct(1, "ZB3")

	// Monta o trigger de busca do usuário
	Local aTrigger := FwStruTrigger( "ZB3_USER", "ZB3_NOME", 'FWGetUserName(M->ZB3_USER)', .F., "", 0,,, "01" )

	// Adiciona o trigger ao struct da ZB3
	oStruZB3:AddTrigger( aTrigger[1], aTrigger[2], aTrigger[3], aTrigger[4] )

	oModel:AddFields("ZB3MASTER", /*cOwner*/, oStruZB3)
	oModel:SetDescription('Modelo de Aprovadores')

	oModel:SetPrimaryKey({'ZB3_FILIAL', 'ZB3_USER'})
	oModel:GetModel('ZB3MASTER'):SetDescription('Modelo de Aprovadores')

Return oModel

/*/{Protheus.doc} ViewDef
	Layout visual do cadastro de aprovadores (ZB3)

	@type user functionPOSICIONE( 'ZB2', 1, XFILIAL( 'ZB2' ) + M->ZB5_DEFIN, 'ZB2_DESC' )                                 

	@author igor.seberino

	@since 23/10/2026

	@return object, a view MVC (FWFormView)
/*/
User Function ViewDef()

	Local oModel := FWLoadModel(NZORCA03 + ".ZORCA03")
	Local oStruZB3 := FWFormStruct(2, "ZB3")
	Local oView := FWFormView():New()

	oView:SetModel( oModel )
	oView:AddField( 'VIEW_ZB3', oStruZB3, 'ZB3MASTER' )

	oView:CreateHorizontalBox( 'TELA', 100 )
	oView:SetOwnerView( 'VIEW_ZB3', 'TELA' )

Return oView

/*/{Protheus.doc} MenuDef
	Acoes disponiveis no cadastro de aprovadores (ZB3)

	@type user function

	@author igor.seberino

	@since 23/10/2026

	@return array, itens de menu
/*/
User Function MenuDef()

	Local aRotina := {}
	//Define a chamada das actions do menu
	Local cActionString := FormatStr("VIEWDEF.%c.ZORCA03", NZORCA03)

	ADD OPTION aRotina Title 'Visualizar' Action cActionString OPERATION 2 ACCESS 0
	ADD OPTION aRotina Title 'Incluir' Action cActionString OPERATION 3 ACCESS 0
	ADD OPTION aRotina Title 'Alterar' Action cActionString OPERATION 4 ACCESS 0
	ADD OPTION aRotina Title 'Excluir' Action NZORCA03 + ".U_ZORCA03Exc()" OPERATION 5 ACCESS 0
	ADD OPTION aRotina Title 'Imprimir' Action cActionString OPERATION 8 ACCESS 0
	ADD OPTION aRotina Title 'Copiar' Action cActionString OPERATION 9 ACCESS 0

Return aRotina

User Function ZORCA03Exc()

	Local oModel := FWLoadModel(NZORCA03 + ".U_ZORCA03")
	Local cQuery := U_QuerySet( "ZB7", {"ZB7_COD"}, { {"ZB7.ZB7_USER = ", ZB3->ZB3_USER}, {"ZB7.ZB7_ACAO != ", ACAO_ENVIADO} })
	Local cAliasQry := MPSysOpenQuery(cQuery)

	// Se tiver registro
	If !(cAliasQry)->(EoF())

		// Se estiver ativo
		If ZB3->ZB3_ATIVO == ATIVO_SIM

			// Pergunta se deseja inativar
			If MsgYesNo("Exclusão indisponível, aprovador tem ações em orçamentos. Deseja inativar?", "Exclusão Indisponível")
				oModel:SetOperation(MODEL_OPERATION_UPDATE)
				oModel:Activate()
				oModel:SetValue("ZB3MASTER", "ZB3_ATIVO", ATIVO_NAO)
				If oModel:VldData()
					oModel:CommitData()
				Else
					Help(, , "ZORCA03EXC", , oModel:GetErrorMessage()[6], 1, 0, ;
						, , , , , {"Contate o suporte."})
				EndIf
				oModel:DeActivate()

			EndIf
		Else
			Aviso("ATENÇÃO", "O aprovador já está inativo, sua exclusão não pode ser efetuada pois ele tem ações em orçamentos", {"Ok"})
		EndIf
	Else
		FWExecView("Excluir", NZORCA03 + ".U_ZORCA03", MODEL_OPERATION_DELETE)
	EndIf

	(cAliasQry)->(dbCloseArea())

Return

/*/{Protheus.doc} VldExclusao
	Pos-validacao do modelo: bloqueia exclusao de area usada em item (RN09)
	@type static function
	@author igor.seberino
	@since 25/11/2026
	@param oModel, object, modelo ZORCA01M
	@return logical, .T. = pode gravar
/*/
Static Function VldExclusao( oModel as object ) as logical

	Local cCod      as character
	Local cQuery    as character
	Local cAliasQry as character
	Local lRet      := .T.

	If oModel:GetOperation() == MODEL_OPERATION_DELETE

		cCod      := oModel:GetValue("ZB3MASTER", "ZB3_USER")
		cQuery    := U_QuerySet("ZB7", {"ZB7_USER"}, { {"ZB7.ZB7_USER = ", cCod}, {"ZB7.ZB7_ACAO != ", ACAO_ENVIADO} } )
		cAliasQry := MPSysOpenQuery(cQuery)

		If !(cAliasQry)->(EoF())
			lRet := .F.
			Help(, , "ZORCA03EXC", , "Aprovador tem ações em orçamentos.", 1, 0, ;
				, , , , , {"Inative o aprovador em vez de excluir."})
		EndIf

		(cAliasQry)->(dbCloseArea())

	EndIf

Return lRet

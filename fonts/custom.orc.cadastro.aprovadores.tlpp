#include "totvs.ch"
#include "fwmvcdef.ch"
#include "custom.orc.th"

namespace custom.orc.cadastro.aprovadores
using namespace custom.orc.utils

/*/{Protheus.doc} ZORCA03
	Cadastro de Aprovadores (ZB3) - tela browse

	@type user function

	@author igor.seberino

	@since 23/10/2026
/*/
User Function ZORCA03()

	Local oBrowse := FWMBrowse():New() as object

	oBrowse:SetAlias("ZB3")
	oBrowse:SetDescription("Cadastro de Aprovadores")

	oBrowse:AddLegend("ZB3_ATIVO == '" + ATIVO_SIM + "'", "GREEN", "Ativa")
	oBrowse:AddLegend("ZB3_ATIVO == '" + ATIVO_NAO + "'", "RED", "Inativa")

	oBrowse:Activate()

Return

/*/{Protheus.doc} ModelDef
	Regras de negócio e estrutura de dados do cadastro de aprovadores (ZB3)

	@type user function

	@author igor.seberino

	@since 23/10/2026

	@return object, o model MVC (MPFormModel)
/*/
User Function ModelDef() as object

	Local oModel   := MPFormModel():New("ZORCA03M", /*bPre*/, { |oModel| VldExclusao(oModel) }) as object
	Local oStruZB3 := FWFormStruct(1, "ZB3") as object

	// Monta o trigger de busca do usuário
	Local aTrigger := FwStruTrigger( "ZB3_USER", "ZB3_NOME", 'FWGetUserName(M->ZB3_USER)', .F., "", 0,,, "01" ) as array

	// Adiciona o trigger ao struct da ZB3
	oStruZB3:AddTrigger( aTrigger[1], aTrigger[2], aTrigger[3], aTrigger[4] )

	oModel:AddFields("ZB3MASTER", /*cOwner*/, oStruZB3)
	oModel:SetDescription('Modelo de Aprovadores')

	oModel:SetPrimaryKey({'ZB3_FILIAL', 'ZB3_USER'})
	oModel:GetModel('ZB3MASTER'):SetDescription('Modelo de Aprovadores')

Return oModel

/*/{Protheus.doc} ViewDef
	Layout visual do cadastro de aprovadores (ZB3)

	@type user function

	@author igor.seberino

	@since 23/10/2026

	@return object, a view MVC (FWFormView)
/*/
User Function ViewDef() as object

	Local oModel   := FWLoadModel(NZORCA03 + ".ZORCA03") as object
	Local oStruZB3 := FWFormStruct(2, "ZB3") as object
	Local oView    := FWFormView():New() as object

	oView:SetModel( oModel )
	oView:AddField( 'VIEW_ZB3', oStruZB3, 'ZB3MASTER' )

	oView:CreateHorizontalBox( 'TELA', 100 )
	oView:SetOwnerView( 'VIEW_ZB3', 'TELA' )

Return oView

/*/{Protheus.doc} MenuDef
	Ações disponíveis no cadastro de aprovadores (ZB3)

	@type user function

	@author igor.seberino

	@since 23/10/2026

	@return array, itens de menu
/*/
User Function MenuDef() as array

	Local aRotina := {} as array
	// Define a chamada das actions do menu
	Local cActionString := FormatStr("VIEWDEF.%c.ZORCA03", NZORCA03) as character

	ADD OPTION aRotina Title 'Visualizar' Action cActionString OPERATION 2 ACCESS 0
	ADD OPTION aRotina Title 'Incluir' Action cActionString OPERATION 3 ACCESS 0
	ADD OPTION aRotina Title 'Alterar' Action cActionString OPERATION 4 ACCESS 0
	ADD OPTION aRotina Title 'Excluir' Action NZORCA03 + ".U_ZORCA03Exc()" OPERATION 5 ACCESS 0
	ADD OPTION aRotina Title 'Imprimir' Action cActionString OPERATION 8 ACCESS 0
	ADD OPTION aRotina Title 'Copiar' Action cActionString OPERATION 9 ACCESS 0

Return aRotina

/*/{Protheus.doc} ZORCA03Exc
	Exclusão customizada da tela ZORCA03.
	Aprovador com ações no histórico (ZB7) não é excluído:
	oferece inativar (RN10)

	@type user function

	@author igor.seberino

	@since 06/11/2026
/*/
User Function ZORCA03Exc()

	// Busca ações do aprovador no histórico (envio não conta)
	Local lEmUso := U_RegEmUso( "ZB7", { { "ZB7.ZB7_USER = ", ZB3->ZB3_USER }, { "ZB7.ZB7_ACAO != ", ACAO_ENVIADO } } ) as logical

	U_ExcOuInativa( NZORCA03, "ZORCA03", "ZB3", lEmUso, ;
		"Exclusão indisponível, aprovador tem ações em orçamentos. Deseja inativar?", ;
		"Exclusão Indisponível", ;
		"O aprovador já está inativo, sua exclusão não pode ser efetuada pois ele tem ações em orçamentos" )

Return

/*/{Protheus.doc} VldExclusao
	Pós-validação do modelo: bloqueia exclusão de aprovador
	com ações no histórico (RN10)

	@type static function

	@author igor.seberino

	@since 25/11/2026

	@param oModel, object, Modelo ZORCA03M

	@return logical, .T. = pode gravar
/*/
Static Function VldExclusao( oModel as object ) as logical

	Local lRet := .T. as logical

	If oModel:GetOperation() == MODEL_OPERATION_DELETE .And. ;
			U_RegEmUso( "ZB7", { { "ZB7.ZB7_USER = ", oModel:GetValue("ZB3MASTER", "ZB3_USER") }, { "ZB7.ZB7_ACAO != ", ACAO_ENVIADO } } )

		lRet := .F.
		Help(, , "ZORCA03EXC", , "Aprovador tem ações em orçamentos.", 1, 0, ;
			, , , , , {"Inative o aprovador em vez de excluir."})

	EndIf

Return lRet

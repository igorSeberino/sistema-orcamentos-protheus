#include "totvs.ch"
#include "fwmvcdef.ch"

namespace custom.orc.cadastro.areas
using namespace custom.orc.utils

#define NAMESPACE "custom.orc.cadastro.areas"

/*/{Protheus.doc} ZORCA01
	Cadastro de Produtos (ZB1) - tela browse

	@type function

	@author igor.seberino
	
	@since 22/10/2026
/*/
User Function ZORCA01()

    Local oBrowse := FWMBrowse():New()

    oBrowse:SetAlias("ZB1")
    oBrowse:SetDescription("Cadastro de 햞eas")

    // oBrowse:AddLegend(/* Campo = Valor */,/* Cor */,/* Legenda */)
    oBrowse:AddLegend("ZB1_ATIVO == '1'", "GREEN", "Ativa")
    oBrowse:AddLegend("ZB1_ATIVO == '2'", "RED", "Inativa")

    oBrowse:Activate()

Return

/*/{Protheus.doc} ModelDef
	Regras de negocio e estrutura de dados do cadastro de 햞eas (ZB1)

	@type user function

	@author igor.seberino

	@since 22/10/2026

	@return object, o model MVC (MPFormModel)
/*/
User Function ModelDef()

    Local oModel := MPFormModel():New("ZORCA01M")
    Local oStruZB1 := FWFormStruct(1, "ZB1")

    oModel:AddFields("ZB1MASTER", /*cOwner*/, oStruZB1)
    oModel:SetDescription('Modelo de 햞eas')

    oModel:SetPrimaryKey({'ZB1_FILIAL', 'ZB1_COD'})
    oModel:GetModel('ZB1MASTER'):SetDescription('Modelo de 햞eas')

    oModel:SetActivate({ |oModel| U_ModelActivate( @oModel, "ZB1" ) })

Return oModel

/*/{Protheus.doc} ViewDef
	Layout visual do cadastro de 햞eas (ZB1)

	@type user function

	@author igor.seberino

	@since 22/10/2026

	@return object, a view MVC (FWFormView)
/*/
User Function ViewDef()

    Local oModel := FWLoadModel(NAMESPACE + ".ZORCA01")
    Local oStruZB1 := FWFormStruct(2, "ZB1")
    Local oView := FWFormView():New()
    
    oView:SetModel( oModel )
    oView:AddField( 'VIEW_ZB1', oStruZB1, 'ZB1MASTER' )

    oView:CreateHorizontalBox( 'TELA', 100 )
    oView:SetOwnerView( 'VIEW_ZB1', 'TELA' )

Return oView

/*/{Protheus.doc} MenuDef
	Acoes disponiveis no cadastro de 햞eas (ZB1)

	@type user function

	@author igor.seberino

	@since 22/10/2026

	@return array, itens de menu
/*/
User Function MenuDef()

    Local aRotina := {}
    //Define a chamada das actions do menu 
    Local cActionString := FormatStr("VIEWDEF.%c.ZORCA01", NAMESPACE)

    ADD OPTION aRotina Title 'Visualizar' Action cActionString OPERATION 2 ACCESS 0
	ADD OPTION aRotina Title 'Incluir' Action cActionString OPERATION 3 ACCESS 0
	ADD OPTION aRotina Title 'Alterar' Action cActionString OPERATION 4 ACCESS 0
	ADD OPTION aRotina Title 'Excluir' Action cActionString OPERATION 5 ACCESS 0
	ADD OPTION aRotina Title 'Imprimir' Action cActionString OPERATION 8 ACCESS 0
	ADD OPTION aRotina Title 'Copiar' Action cActionString OPERATION 9 ACCESS 0

Return aRotina

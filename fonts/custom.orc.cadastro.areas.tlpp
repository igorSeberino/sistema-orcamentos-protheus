#include "totvs.ch"
#include "fwmvcdef.ch"
#include "custom.orc.th"

namespace custom.orc.cadastro.areas
using namespace custom.orc.utils

/*/{Protheus.doc} ZORCA01
	Cadastro de Áreas (ZB1) - tela browse

	@type user function

	@author igor.seberino

	@since 22/10/2026
/*/
User Function ZORCA01()

	Local oBrowse := FWMBrowse():New() as object

	oBrowse:SetAlias( "ZB1" )
	oBrowse:SetDescription( "Cadastro de Áreas" )

	oBrowse:AddLegend( "ZB1_ATIVO == '" + ATIVO_SIM + "'", "GREEN", "Ativa" )
	oBrowse:AddLegend( "ZB1_ATIVO == '" + ATIVO_NAO + "'", "RED", "Inativa" )

	oBrowse:Activate()

Return

/*/{Protheus.doc} ModelDef
	Regras de negócio e estrutura de dados do cadastro de Áreas (ZB1)

	@type user function

	@author igor.seberino

	@since 22/10/2026

	@return object, o model MVC (MPFormModel)
/*/
User Function ModelDef() as object

	Local oModel    := MPFormModel():New("ZORCA01M", /*bPre*/, { |oModel| VldExclusao(oModel) }) as object
	Local oStruZB1  := FWFormStruct( 1, "ZB1" ) as object
	Local oStruZB5  := FWFormStruct( 1, "ZB5" ) as object

	oModel:AddFields( "ZB1MASTER", /*cOwner*/, oStruZB1 )
	oModel:AddGrid(   "ZB5DETAIL", "ZB1MASTER", oStruZB5 )

	oModel:SetDescription( 'Modelo de Áreas' )

	oModel:SetRelation( "ZB5DETAIL", {;
		{ "ZB5_FILIAL", "xFilial('ZB5')" }, ;
		{ "ZB5_AREA",   "ZB1_COD" } ;
		}, ZB5->(IndexKey(3)) )

	oModel:SetPrimaryKey( {'ZB1_FILIAL', 'ZB1_COD'} )

	oModel:GetModel( 'ZB1MASTER' ):SetDescription( 'Modelo de Áreas' )

	oModel:GetModel( 'ZB5DETAIL' ):SetOnlyQuery(    .T. )
	oModel:GetModel(  'ZB5DETAIL' ):SetOptional(     .T. )
	oModel:GetModel(  'ZB5DETAIL' ):SetNoInsertLine( .T. )
	oModel:GetModel(  'ZB5DETAIL' ):SetNoUpdateLine( .T. )
	oModel:GetModel(  'ZB5DETAIL' ):SetNoDeleteLine( .T. )

Return oModel

/*/{Protheus.doc} ViewDef
	Layout visual do cadastro de Áreas (ZB1)

	@type user function

	@author igor.seberino

	@since 22/10/2026

	@return object, a view MVC (FWFormView)
/*/
User Function ViewDef() as object

	Local oModel    := FWLoadModel( NZORCA01 + ".ZORCA01" ) as object
	Local oStruZB1  := FWFormStruct( 2, "ZB1" ) as object
	Local oStruZB5  := FWFormStruct( 2, "ZB5" ) as object
	Local oView     := FWFormView():New() as object

	oView:SetModel( oModel )
	oView:AddField( 'VIEW_ZB1', oStruZB1, 'ZB1MASTER' )
	oView:AddGrid(  'VIEW_ZB5', oStruZB5, 'ZB5DETAIL' )
	
	oStruZB5:RemoveField("ZB5_COD")
	oStruZB5:RemoveField("ZB5_REV")
	oStruZB5:RemoveField("ZB5_TTHRNM")
	oStruZB5:RemoveField("ZB5_AREA")
	oStruZB5:RemoveField("ZB5_DESARE")
	oStruZB5:RemoveField("ZB5_DEF")

	oView:CreateHorizontalBox( 'AREA', 20 )
	oView:CreateHorizontalBox( 'ITEM', 80 )

	oView:CreateFolder( 'FOLDER', 'ITEM' )
	oView:AddSheet( 'FOLDER', 'ITENS', 'Itens' )

	oView:CreateHorizontalBox( 'BOX_ZB5', 100, , ,  'FOLDER', 'ITENS' )

	oView:SetOwnerView( 'VIEW_ZB1', 'AREA' )
	oView:SetOwnerView( 'VIEW_ZB5', 'BOX_ZB5' )

	oView:AddUserButton( "Visualizar orçamento", "", { |oView| ViewOrcamento(oView) }, "Visualiza o orçamento do item" )

Return oView

/*/{Protheus.doc} MenuDef
	Ações disponíveis no cadastro de Áreas (ZB1)

	@type user function

	@author igor.seberino

	@since 22/10/2026

	@return array, itens de menu
/*/
User Function MenuDef() as array

	Local aRotina := {} as array
	// Define a chamada das actions do menu
	Local cActionString := FormatStr( "VIEWDEF.%c.ZORCA01", NZORCA01 ) as character

	ADD OPTION aRotina Title 'Visualizar' Action cActionString OPERATION 2 ACCESS 0
	ADD OPTION aRotina Title 'Incluir' Action cActionString OPERATION 3 ACCESS 0
	ADD OPTION aRotina Title 'Alterar' Action cActionString OPERATION 4 ACCESS 0
	ADD OPTION aRotina Title 'Excluir' Action NZORCA01 + ".U_ZORCA01Exc()" OPERATION 5 ACCESS 0
	ADD OPTION aRotina Title 'Imprimir' Action cActionString OPERATION 8 ACCESS 0
	ADD OPTION aRotina Title 'Copiar' Action cActionString OPERATION 9 ACCESS 0

Return aRotina

/*/{Protheus.doc} ZORCA01Exc
	Exclusão customizada da tela ZORCA01.
	Área usada em item de orçamento (ZB5) não é excluída:
	oferece inativar (RN09)

	@type user function

	@author igor.seberino

	@since 30/10/2026
/*/
User Function ZORCA01Exc()

	// Busca registros da ZB5 associados ao registro da ZB1
	Local lEmUso := U_RegEmUso( "ZB5", { { "ZB5.ZB5_AREA = ", ZB1->ZB1_COD } } ) as logical

	U_ExcOuInativa( NZORCA01, "ZORCA01", "ZB1", lEmUso, ;
		"Exclusão indisponível, área já está sendo usada em orçamento. Deseja inativar?", ;
		"Área em uso", ;
		"A área já esta inativa, sua exclusão não pode ser efetuada pois está sendo usada em orçamento" )

Return

/*/{Protheus.doc} VldExclusao
	Pós-validação do modelo: bloqueia exclusão de área usada em item (RN09)

	@type static function

	@author igor.seberino

	@since 25/11/2026

	@param oModel, object, Modelo ZORCA01M

	@return logical, .T. = pode gravar
/*/
Static Function VldExclusao( oModel as object ) as logical

	Local lRet := .T. as logical

	If oModel:GetOperation() == MODEL_OPERATION_DELETE .And. ;
			U_RegEmUso( "ZB5", { { "ZB5.ZB5_AREA = ", oModel:GetValue("ZB1MASTER", "ZB1_COD") } } )

		lRet := .F.
		Help(, , "ZORCA01EXC", , "Área já usada em orçamento.", 1, 0, ;
			, , , , , {"Inative a área em vez de excluir."})

	EndIf

Return lRet

/*/{Protheus.doc} ViewOrcamento
	Botão "Atividades Similares": abre a consulta histórica
	(ZORCA07) filtrada pela definição do item posicionado

	@type static function

	@author igor.seberino

	@since 18/11/2026

	@param oView, object, View ativa
/*/
Static Function ViewOrcamento( oView as object )

	Local aArea  := GetArea() as array
	Local oModel := oView:GetModel():GetModel( "ZB5DETAIL" ) as object
	Local cCod   as character
	Local cRev   as character
	Local cChave as character

	If Empty(oModel)
		Help(, , "ZORCA01", , "Sem orçamento para visualizar.", 1, 0 )
		Return
	EndIf

	cCod   := oModel:GetValue( "ZB5_COD" )
	cRev   := oModel:GetValue( "ZB5_REV" )
	cChave := FWxFilial("ZB5") + cCod + cRev

	DbSelectArea("ZB4")
	ZB4->(DbSetOrder(1))
	ZB4->(DbSeek(cChave))

	FWExecView("Visualizar", FormatStr("VIEWDEF.%c.ZORCA04", NZORCA04), MODEL_OPERATION_VIEW)

	RestArea(aArea)

Return

#include "totvs.ch"
#include "fwmvcdef.ch"

namespace custom.orc.cadastro.definicoes
using namespace custom.orc.utils

#define NAMESPACE "custom.orc.cadastro.definicoes"

/*/{Protheus.doc} ZORCA02
	Cadastro de Definições (ZB2) - tela browse

	@type function

	@author igor.seberino
	
	@since 23/10/2026
/*/
User Function ZORCA02()

    Local oBrowse := FWMarkBrowse():New()

    oBrowse:SetAlias("ZB2")
    oBrowse:SetDescription("Cadastro de Definições")

    // oBrowse:AddLegend(/* Campo = Valor */,/* Cor */,/* Legenda */)
    oBrowse:AddLegend("ZB2_ATIVO == '1'", "GREEN", "Ativa")
    oBrowse:AddLegend("ZB2_ATIVO == '2'", "RED", "Inativa")

    oBrowse:Activate()

Return

/*/{Protheus.doc} ModelDef
	Regras de negocio e estrutura de dados do cadastro de Definições (ZB2)

	@type static function

	@author igor.seberino

	@since 23/10/2026

	@return object, o model MVC (MPFormModel)
/*/
User Function ModelDef()

    Local oModel := MPFormModel():New("ZORCA02M")
    Local oStruZB2 := FWFormStruct(1, "ZB2")

    oModel:AddFields("ZB2MASTER", /*cOwner*/, oStruZB2)
    oModel:SetDescription('Modelo de Definições')

    oModel:SetPrimaryKey({'ZB2_FILIAL', 'ZB2_COD'})
    oModel:GetModel('ZB2MASTER'):SetDescription('Modelo de Definições')

    oModel:SetActivate({ |oModel| U_ModelActivate( @oModel, "ZB2" ) })

Return oModel

/*/{Protheus.doc} ViewDef
	Layout visual do cadastro de Definições (ZB2)

	@type static function

	@author igor.seberino

	@since 23/10/2026

	@return object, a view MVC (FWFormView)
/*/
User Function ViewDef()

    Local oModel := FWLoadModel(NAMESPACE + ".ZORCA02")
    Local oStruZB2 := FWFormStruct(2, "ZB2")
    Local oView := FWFormView():New()
    
    oView:SetModel( oModel )
    oView:AddField( 'VIEW_ZB2', oStruZB2, 'ZB2MASTER' )

    oView:CreateHorizontalBox( 'TELA', 100 )
    oView:SetOwnerView( 'VIEW_ZB2', 'TELA' )

Return oView

/*/{Protheus.doc} MenuDef
	Acoes disponiveis no cadastro de Definições (ZB2)

	@type static function

	@author igor.seberino

	@since 23/10/2026

	@return array, itens de menu
/*/
User Function MenuDef()

    Local aRotina := {}
    //Define a chamada das actions do menu 
    Local cActionString := FormatStr("VIEWDEF.%c.ZORCA02", NAMESPACE)

    ADD OPTION aRotina Title 'Visualizar' Action cActionString OPERATION 2 ACCESS 0
	ADD OPTION aRotina Title 'Incluir' Action cActionString OPERATION 3 ACCESS 0
	ADD OPTION aRotina Title 'Alterar' Action cActionString OPERATION 4 ACCESS 0
	ADD OPTION aRotina Title 'Excluir' Action cActionString OPERATION 5 ACCESS 0
	ADD OPTION aRotina Title 'Imprimir' Action cActionString OPERATION 8 ACCESS 0
	ADD OPTION aRotina Title 'Copiar' Action cActionString OPERATION 9 ACCESS 0

Return aRotina

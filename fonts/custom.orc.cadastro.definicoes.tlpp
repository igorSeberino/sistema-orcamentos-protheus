#include "totvs.ch"
#include "fwmvcdef.ch"
#include "custom.orc.th"

namespace custom.orc.cadastro.definicoes
using namespace custom.orc.utils

/*/{Protheus.doc} ZORCA02
	Cadastro de Definições (ZB2) - tela browse

	@type function

	@author igor.seberino
	
	@since 23/10/2026
/*/
User Function ZORCA02()

	Local oBrowse := FWMBrowse():New()

	oBrowse:SetAlias("ZB2")
	oBrowse:SetDescription("Cadastro de Definições")

	// oBrowse:AddLegend(/* Campo = Valor */,/* Cor */,/* Legenda */)
	oBrowse:AddLegend("ZB2_ATIVO == '" + ATIVO_SIM + "'", "GREEN", "Ativa")
	oBrowse:AddLegend("ZB2_ATIVO == '" + ATIVO_NAO + "'", "RED", "Inativa")

	oBrowse:Activate()

Return

/*/{Protheus.doc} ModelDef
	Regras de negocio e estrutura de dados do cadastro de Definições (ZB2)

	@type user function

	@author igor.seberino

	@since 23/10/2026

	@return object, o model MVC (MPFormModel)
/*/
User Function ModelDef()

	Local oModel := MPFormModel():New("ZORCA02M", /*bPre*/, { |oModel| VldExclusao(oModel) })
	Local oStruZB2 := FWFormStruct(1, "ZB2")

	oModel:AddFields("ZB2MASTER", /*cOwner*/, oStruZB2)
	oModel:SetDescription('Modelo de Definições')

	oModel:SetPrimaryKey({'ZB2_FILIAL', 'ZB2_COD'})
	oModel:GetModel('ZB2MASTER'):SetDescription('Modelo de Definições')

Return oModel

/*/{Protheus.doc} ViewDef
	Layout visual do cadastro de Definições (ZB2)

	@type user function

	@author igor.seberino

	@since 23/10/2026

	@return object, a view MVC (FWFormView)
/*/
User Function ViewDef()

	Local oModel := FWLoadModel(NZORCA02 + ".ZORCA02")
	Local oStruZB2 := FWFormStruct(2, "ZB2")
	Local oView := FWFormView():New()

	oView:SetModel( oModel )
	oView:AddField( 'VIEW_ZB2', oStruZB2, 'ZB2MASTER' )

	oView:CreateHorizontalBox( 'TELA', 100 )
	oView:SetOwnerView( 'VIEW_ZB2', 'TELA' )

Return oView

/*/{Protheus.doc} MenuDef
	Acoes disponiveis no cadastro de Definições (ZB2)

	@type user function

	@author igor.seberino

	@since 23/10/2026

	@return array, itens de menu
/*/
User Function MenuDef()

	Local aRotina := {}
	//Define a chamada das actions do menu
	Local cActionString := FormatStr("VIEWDEF.%c.ZORCA02", NZORCA02)

	ADD OPTION aRotina Title 'Visualizar' Action cActionString OPERATION 2 ACCESS 0
	ADD OPTION aRotina Title 'Incluir' Action cActionString OPERATION 3 ACCESS 0
	ADD OPTION aRotina Title 'Alterar' Action cActionString OPERATION 4 ACCESS 0
	ADD OPTION aRotina Title 'Excluir' Action NZORCA02 + ".U_ZORCA02Exc()" OPERATION 5 ACCESS 0
	ADD OPTION aRotina Title 'Imprimir' Action cActionString OPERATION 8 ACCESS 0
	ADD OPTION aRotina Title 'Copiar' Action cActionString OPERATION 9 ACCESS 0

Return aRotina

/*/{Protheus.doc} ZORCA02Exc
	Exclusão customizada da tela ZORCA02. 
    Segue as regras de exclusão definidas no escopo

	@type user function

	@author igor.seberino

	@since 30/10/2026

	@return Nil
/*/
User Function ZORCA02Exc()

	Local oModel := FWLoadModel(NZORCA02 + ".U_ZORCA02")

	// Busca registros da ZB5 associados ao registro da ZB1
	Local cQuery := U_QuerySet( "ZB5", {"ZB5_COD"}, { {"ZB5.ZB5_DEFIN = ", ZB2->ZB2_COD} })
	Local cAliasQry := MPSysOpenQuery(cQuery)

	// Se tiver registro
	If !(cAliasQry)->(EoF())

		// Se estiver ativo
		If ZB2->ZB2_ATIVO == ATIVO_SIM

			// Pergunta se deseja inativar
			If MsgYesNo("Exclusão indisponível, definição já está sendo usada em orçamento. Deseja inativar?", "Definição em uso")
				oModel:SetOperation(MODEL_OPERATION_UPDATE)
				oModel:Activate()
				oModel:SetValue("ZB2MASTER", "ZB2_ATIVO", ATIVO_NAO)
				If oModel:VldData()
					oModel:CommitData()
				Else
					Help(, , "ZORCA02EXC", , oModel:GetErrorMessage()[6], 1, 0, ;
						, , , , , {"Contate o suporte."})
				EndIf	
				oModel:DeActivate()

			EndIf
		Else
			Aviso("ATENÇÃO", "A definição já esta inativa, sua exclusão não pode ser efetuada pois está sendo usada em orçamento", {"Ok"})
		EndIf
	Else
		FWExecView("Excluir", NZORCA02 + ".U_ZORCA02", MODEL_OPERATION_DELETE)
	EndIf

	(cAliasQry)->(dbCloseArea())

Return

/*/{Protheus.doc} VldExclusao
	Pos-validacao do modelo: bloqueia exclusao de area usada em item (RN09)
	@type static function
	@author igor.seberino
	@since 25/11/2026
	@param oModel, object, modelo ZORCA01M
	@return logical, .T. = pode gravar
/*/
Static Function VldExclusao( oModel as object ) as logical

	Local cCod      as character
	Local cQuery    as character
	Local cAliasQry as character
	Local lRet      := .T.

	If oModel:GetOperation() == MODEL_OPERATION_DELETE

		cCod      := oModel:GetValue("ZB2MASTER", "ZB2_COD")
		cQuery    := U_QuerySet("ZB5", {"ZB5_COD"}, { {"ZB5.ZB5_DEFIN = ", cCod} })
		cAliasQry := MPSysOpenQuery(cQuery)

		If !(cAliasQry)->(EoF())
			lRet := .F.
			Help(, , "ZORCA02EXC", , "Definição já usada em orçamento.", 1, 0, ;
				, , , , , {"Inative a definição em vez de excluir."})
		EndIf

		(cAliasQry)->(dbCloseArea())

	EndIf

Return lRet


#include "totvs.ch"
#include "tlpp-core.th"
#include "fwmvcdef.ch"
#include "custom.orc.th"

namespace custom.orc.orcamento.manutencao
using namespace custom.orc.utils

/*/{Protheus.doc} ZORCA04
	Orçamentos (browse e manutenção) (ZB4) - tela browse

	@type user function

	@author igor.seberino

	@since 25/10/2026
/*/
User Function ZORCA04()

	Local oBrowse := FWMBrowse():New() as object
	Local cFiltro := "@R_E_C_N_O_ IN ( SELECT ZB4B.R_E_C_N_O_ FROM " + RetSqlName("ZB4") + " ZB4B" + ;
		" WHERE ZB4B.D_E_L_E_T_ = ' '" + ;
		" AND NOT EXISTS ( SELECT 1 FROM " + RetSqlName("ZB4") + " ZB4C" + ;
		" WHERE ZB4C.ZB4_FILIAL = ZB4B.ZB4_FILIAL" + ;
		" AND ZB4C.ZB4_COD = ZB4B.ZB4_COD" + ;
		" AND ZB4C.ZB4_REV > ZB4B.ZB4_REV" + ;
		" AND ZB4C.D_E_L_E_T_ = ' ' ) )" as character

	oBrowse:SetAlias("ZB4")
	oBrowse:SetDescription("Orçamentos (browse e manutenção)")

	oBrowse:SetFilterDefault( cFiltro )

	oBrowse:AddLegend("ZB4_STATUS == '" + STATUS_RASCUNHO + "'", "WHITE", "Rascunho")
	oBrowse:AddLegend("ZB4_STATUS == '" + STATUS_ENVIADO + "'", "YELLOW", "Enviado")
	oBrowse:AddLegend("ZB4_STATUS == '" + STATUS_APROVADO + "'", "GREEN", "Aprovado")
	oBrowse:AddLegend("ZB4_STATUS == '" + STATUS_REPROVADO + "'", "RED", "Reprovado")

	oBrowse:Activate()

Return

/*/{Protheus.doc} ModelDef
	Regras de negócio e estrutura de dados do Orçamentos (browse e manutenção) (ZB4)

	@type user function

	@author igor.seberino

	@since 25/10/2026

	@return object, o model MVC (MPFormModel)
/*/
User Function ModelDef() as object

	Local oModel   := MPFormModel():New("ZORCA04M") as object
	Local oStruZB4 := FWFormStruct(1, "ZB4") as object
	Local oStruZB5 := FWFormStruct(1, "ZB5") as object
	Local oStruZB6 := FWFormStruct(1, "ZB6") as object
	Local oStruZB7 := FWFormStruct(1, "ZB7") as object

	// Seta os triggers do model
	TriggerSet( oStruZB4, oStruZB5, oStruZB6 )

	oModel:AddFields("ZB4MASTER", /*cOwner*/, oStruZB4)
	oModel:AddGrid("ZB5DETAIL", "ZB4MASTER", oStruZB5)
	oModel:AddGrid("ZB6DETAIL", "ZB5DETAIL", oStruZB6)
	oModel:AddGrid("ZB7DETAIL", "ZB4MASTER", oStruZB7)
	oModel:SetDescription('Modelo de Orçamentos')

	// Seta os relacionamentos do model
	RelationSet( oModel )

	oModel:GetModel('ZB4MASTER'):SetDescription('Modelo de Orçamentos')
	oModel:GetModel("ZB5DETAIL"):SetUniqueLine( { "ZB5_ITEM" } )
	oModel:GetModel("ZB6DETAIL"):SetUniqueLine( { "ZB6_SUB" } )

	// Define o preenchimento do modelo como opcional
	oModel:GetModel("ZB6DETAIL"):SetOptional(.T.)
	oModel:GetModel("ZB7DETAIL"):SetOptional(.T.)

	// Apenas leitura
	oModel:GetModel("ZB7DETAIL"):SetOnlyQuery(.T.)
	oModel:GetModel("ZB7DETAIL"):SetNoInsertLine(.T.)
	oModel:GetModel("ZB7DETAIL"):SetNoUpdateLine(.T.)
	oModel:GetModel("ZB7DETAIL"):SetNoDeleteLine(.T.)

	// Define chave primária da entidade Model
	oModel:SetPrimaryKey({ "ZB4_FILIAL", "ZB4_COD", "ZB4_REV" })

	oModel:SetActivate({ |oModel| ZB4Activate( oModel ) })

	// Condiciona a edição do orçamento ao status de rascunho
	oModel:SetVldActive( { |oModel| VldActivate( oModel ) } )

	oModel:SetCommit({|oModel| ModelCommit(oModel)})

Return oModel

/*/{Protheus.doc} ViewDef
	Layout visual do Orçamentos (browse e manutenção) (ZB4)

	@type user function

	@author igor.seberino

	@since 25/10/2026

	@return object, a view MVC (FWFormView)
/*/
User Function ViewDef() as object

	Local oModel   := FWLoadModel(NZORCA04 + ".ZORCA04") as object
	Local oStruZB4 := FWFormStruct(2, "ZB4") as object
	Local oStruZB5 := FWFormStruct(2, "ZB5") as object
	Local oStruZB6 := FWFormStruct(2, "ZB6") as object
	Local oStruZB7 := FWFormStruct(2, "ZB7") as object
	Local oView    := FWFormView():New() as object

	// Esconde campos do usuário (controle interno)
	RemoveFields( oStruZB4, oStruZB5, oStruZB6, oStruZB7 )

	oView:SetModel( oModel )
	oView:AddField( 'VIEW_ZB4', oStruZB4, 'ZB4MASTER' )
	oView:AddGrid(  'VIEW_ZB5', oStruZB5, 'ZB5DETAIL' )
	oView:AddGrid(  'VIEW_ZB6', oStruZB6, 'ZB6DETAIL' )
	oView:AddGrid(  'VIEW_ZB7', oStruZB7, 'ZB7DETAIL' )

	oView:CreateHorizontalBox( 'TELA', 60 )
	oView:CreateHorizontalBox( 'PASTAS', 40 )

	oView:CreateFolder( 'FOLDER', 'PASTAS' )
	oView:AddSheet( 'FOLDER', 'ATIVIDADES', 'Atividades' )
	oView:AddSheet( 'FOLDER', 'HISTORICO', 'Histórico de Aprovação' )

	oView:CreateHorizontalBox('BOX_ZB5', 50, , ,  'FOLDER', 'ATIVIDADES')
	oView:CreateHorizontalBox('BOX_ZB6', 50, , ,  'FOLDER', 'ATIVIDADES')
	oView:CreateHorizontalBox('BOX_ZB7', 100, , , 'FOLDER', 'HISTORICO')

	oView:SetOwnerView( 'VIEW_ZB4', 'TELA' )
	oView:SetOwnerView( 'VIEW_ZB5', 'BOX_ZB5' )
	oView:SetOwnerView( 'VIEW_ZB6', 'BOX_ZB6' )
	oView:SetOwnerView( 'VIEW_ZB7', 'BOX_ZB7' )

	// Define o código incrementais para ZB5 e ZB6
	oView:AddIncrementField("VIEW_ZB5", "ZB5_ITEM")
	oView:AddIncrementField("VIEW_ZB6", "ZB6_SUB")

	// Oculta o histórico na inclusão
	oView:SetAfterViewActivate( { |oView| HideHist( oView ) } )

	oView:AddUserButton( "Atividades Similares", "", { |oView| AtivSimilares( oView ) }, "Consulta histórica pela definição do item", , { MODEL_OPERATION_VIEW, MODEL_OPERATION_UPDATE } )

	oView:AddUserButton( "Visualizar Cliente", "", { |oView| U_ViewCliente( oView:GetModel():GetValue("ZB4MASTER", "ZB4_CLIENT"), oView:GetModel():GetValue("ZB4MASTER", "ZB4_LOJA") ) }, "Visualizar cliente do orçamento" )

	oView:AddUserButton( "Outras revisões", "", { |oView| U_VisualizaRevisoes( oView:GetModel():GetValue("ZB4MASTER", "ZB4_COD"), oView:GetModel():GetValue("ZB4MASTER", "ZB4_REV") ) }, "Visualiza outra revisão do orçamento", , { MODEL_OPERATION_VIEW } )

Return oView

/*/{Protheus.doc} MenuDef
	Ações disponíveis no Orçamentos (browse e manutenção) (ZB4)

	@type user function

	@author igor.seberino

	@since 25/10/2026

	@return array, itens de menu
/*/
User Function MenuDef() as array

	Local aRotina := {} as array
	// Define a chamada das actions do menu
	Local cActionString := FormatStr("VIEWDEF.%c.ZORCA04", NZORCA04) as character

	ADD OPTION aRotina Title 'Visualizar'          Action cActionString                   OPERATION 2 ACCESS 0
	ADD OPTION aRotina Title 'Incluir'             Action cActionString                   OPERATION 3 ACCESS 0
	ADD OPTION aRotina Title 'Alterar'             Action cActionString                   OPERATION 4 ACCESS 0
	ADD OPTION aRotina Title 'Excluir'             Action cActionString                   OPERATION 5 ACCESS 0
	ADD OPTION aRotina Title 'Copiar'              Action cActionString                   OPERATION 9 ACCESS 0
	ADD OPTION aRotina Title 'Visualizar Revisões' Action NUTILS + ".U_VisualizaRevisoes( ZB4->ZB4_COD )" OPERATION 2 ACCESS 0
	ADD OPTION aRotina Title 'Visualizar Cliente'  Action NUTILS + ".U_ViewCliente( ZB4->ZB4_CLIENT, ZB4->ZB4_LOJA )" OPERATION 2 ACCESS 0
	ADD OPTION aRotina Title 'Imprimir'            Action NZORCR01 + ".U_ZORCR01()"        OPERATION 8 ACCESS 0
	ADD OPTION aRotina Title 'Enviar Rascunho'     Action NZORCA05 + ".U_ZORCA05( 'ENV' )" OPERATION 4 ACCESS 0
	ADD OPTION aRotina Title 'Novo Rascunho'       Action NZORCA05 + ".U_ZORCA05( 'NOV' )" OPERATION 3 ACCESS 0
	ADD OPTION aRotina Title 'Importar CSV'        Action NZORCA06 + ".U_ZORCA06()"        OPERATION 3 ACCESS 0
	ADD OPTION aRotina Title 'Consulta Histórica'  Action NZORCA07 + ".U_ZORCA07()"        OPERATION 2 ACCESS 0
	If U_IsAprovador( RetCodUsr() )
		ADD OPTION aRotina Title 'Aprovação'       Action NZORCA05 + ".U_ZORCA05( 'APR' )" OPERATION 4 ACCESS 0
		ADD OPTION aRotina Title 'Estornar'        Action NZORCA05 + ".U_ZORCA05( 'EST' )" OPERATION 4 ACCESS 0
	EndIf

Return aRotina

/*/{Protheus.doc} VldData
	Valida se a data de validade é posterior à data de criação.
	Chamada pela validação do campo no dicionário.

	@type user function

	@author igor.seberino

	@since 26/10/2026

	@return logical, .T. se a validade é válida
/*/
User Function VldData() as logical

	Local lRet       := .T. as logical
	Local dDataInit  := M->ZB4_DATA as date
	Local dDataValid := M->ZB4_VALID as date

	If dDataInit > dDataValid
		Help(, , "HELP", "", "Validade não pode ser anterior à data de abertura do orçamento", 1, 0)
		lRet := .F.
	EndIf

Return lRet

/*/{Protheus.doc} TriggerSet
	Separação da criação dos triggers da
	ModelDef(). Apenas por organização

	@type static function

	@author igor.seberino

	@since 30/10/2026

	@param oStruZB4, object, Estrutura do modelo da ZB4
	@param oStruZB5, object, Estrutura do modelo da ZB5
	@param oStruZB6, object, Estrutura do modelo da ZB6
/*/
Static Function TriggerSet( oStruZB4 as object, oStruZB5 as object, oStruZB6 as object )

	Local aTriggersZB4 := {} as array
	Local aTriggersZB5 := {} as array
	Local aTriggersZB6 := {} as array
	Local nI as numeric

	// Monta triggers de ZB4
	aAdd( aTriggersZB4, FwStruTrigger( "ZB4_LOJA", "ZB4_NOMCLI", 'Posicione("SA1", 1, xFilial("SA1") + M->ZB4_CLIENT + M->ZB4_LOJA, "A1_NOME")', .F., "", 0,,, "01" ) )
	aAdd( aTriggersZB4, FwStruTrigger( "ZB4_HRDIA", "ZB4_HRDNUM", NUTILS + '.U_HoursToNum(M->ZB4_HRDIA)', .F., "", 0,,, "01" ) )
	aAdd( aTriggersZB4, FwStruTrigger( "ZB4_TOTHR", "ZB4_TTHRNM", NUTILS + '.U_HoursToNum(M->ZB4_TOTHR)', .F., "", 0,,, "01" ) )

	// Monta triggers de ZB5
	aAdd( aTriggersZB5, FwStruTrigger( "ZB5_DEFIN", "ZB5_DESDEF", 'Posicione("ZB2", 1, xFilial("ZB2") + M->ZB5_DEFIN, "ZB2_DESC")', .F., "", 0,,, "01" ) )
	aAdd( aTriggersZB5, FwStruTrigger( "ZB5_AREA", "ZB5_DESARE", 'Posicione("ZB1", 1, xFilial("ZB1") + M->ZB5_AREA, "ZB1_DESC")', .F., "", 0,,, "01" ) )

	// Triggers de ZB6 (Hora char p/ hora num)
	aAdd( aTriggersZB6, FWStruTrigger( "ZB6_HDOC", "ZB6_HDOCNM", NUTILS + ".U_HoursToNum(M->ZB6_HDOC)", .F., "", 0,,, "01" ) )
	aAdd( aTriggersZB6, FWStruTrigger( "ZB6_HDEV", "ZB6_HDEVNM", NUTILS + ".U_HoursToNum(M->ZB6_HDEV)", .F., "", 0,,, "01" ) )
	aAdd( aTriggersZB6, FWStruTrigger( "ZB6_HANA", "ZB6_HANANM", NUTILS + ".U_HoursToNum(M->ZB6_HANA)", .F., "", 0,,, "01" ) )
	aAdd( aTriggersZB6, FWStruTrigger( "ZB6_HVAL", "ZB6_HVALNM", NUTILS + ".U_HoursToNum(M->ZB6_HVAL)", .F., "", 0,,, "01" ) )

	// ZB6 Cálculo horas totais
	aAdd( aTriggersZB6, FWStruTrigger( "ZB6_HDOCNM", "ZB6_TTHRNM", NZORCA04 + ".U_ZB6CalcHrs()", .F., "", 0,,, "01" ) )
	aAdd( aTriggersZB6, FWStruTrigger( "ZB6_HDEVNM", "ZB6_TTHRNM", NZORCA04 + ".U_ZB6CalcHrs()", .F., "", 0,,, "01" ) )
	aAdd( aTriggersZB6, FWStruTrigger( "ZB6_HANANM", "ZB6_TTHRNM", NZORCA04 + ".U_ZB6CalcHrs()", .F., "", 0,,, "01" ) )
	aAdd( aTriggersZB6, FWStruTrigger( "ZB6_HVALNM", "ZB6_TTHRNM", NZORCA04 + ".U_ZB6CalcHrs()", .F., "", 0,,, "01" ) )

	// Adiciona triggers à ZB4
	For nI := 1 to Len(aTriggersZB4)
		oStruZB4:AddTrigger( aTriggersZB4[nI][1], aTriggersZB4[nI][2], aTriggersZB4[nI][3], aTriggersZB4[nI][4] )
	Next nI

	// Adiciona triggers à ZB5
	For nI := 1 to Len(aTriggersZB5)
		oStruZB5:AddTrigger( aTriggersZB5[nI][1], aTriggersZB5[nI][2], aTriggersZB5[nI][3], aTriggersZB5[nI][4] )
	Next nI

	// Adiciona triggers à ZB6
	For nI := 1 to Len(aTriggersZB6)
		oStruZB6:AddTrigger( aTriggersZB6[nI][1], aTriggersZB6[nI][2], aTriggersZB6[nI][3], aTriggersZB6[nI][4] )
	Next nI

Return

/*/{Protheus.doc} VldHrs
	Valida o campo horas e seta o campo
	dias já convertido.
	Chamada pela validação do campo no dicionário.

	@type user function

	@author igor.seberino

	@since 03/11/2026

	@param cFieldDays, character, Campo de dias correspondente (ex.: ZB6_DDOC)
	@param nHoras, numeric, Horas digitadas em decimal

	@return logical, .T. se as horas são válidas
/*/
User Function VldHrs( cFieldDays as character , nHoras as numeric ) as logical

	Local oModel    := FWModelActive() as object
	Local oModelZB6 := oModel:GetModel("ZB6DETAIL") as object
	Local cFieldHrs := "ZB6_H" + SubStr( cFieldDays, 6 ) as character  // ZB6_DDOC -> ZB6_HDOC
	Local nDias     as numeric

	If nHoras < 0
		Help( , , "HELP", , "Horas não podem ser negativas.", 1, 0 )
		Return .F.
	EndIf

	// Converte horas em dias
	nDias := nHoras / FwFldGet("ZB4_HRDNUM")

	// Seta na var de dias
	oModelZB6:LoadValue( cFieldDays, nDias )

	// Regrava as horas padronizadas ("8" -> "8:00", "00008:30" -> "8:30")
	oModelZB6:LoadValue( cFieldHrs, U_NumToHours( nHoras ) )

Return .T.

/*/{Protheus.doc} VldDias
	Valida o campo dias e seta o campo
	horas já convertido.
	Chamada pela validação do campo no dicionário.

	@type user function

	@author igor.seberino

	@since 03/11/2026

	@param cFieldHrs, character, Campo de horas correspondente (ex.: ZB6_HDOC)
	@param nDias, numeric, Dias digitados

	@return logical, .T. se os dias são válidos
/*/
User Function VldDias( cFieldHrs as character, nDias as numeric ) as logical

	Local oModel    := FWModelActive() as object
	Local oModelZB6 := oModel:GetModel("ZB6DETAIL") as object
	Local cHoras    as character
	Local lRet      := .T. as logical

	If nDias < 0
		Help( , , "HELP", , "Dias não podem ser negativos.", 1, 0 )
		Return .F.
	EndIf

	// Converte dias em horas
	cHoras := PadL(U_NumToHours(nDias * FwFldGet("ZB4_HRDNUM")), 8, "0")

	// Seta o valor de horas
	If !oModelZB6:SetValue( cFieldHrs, cHoras )
		Help( , , "HELP", , "Ocorreu um erro ao setar o valor de horas.", 1, 0 )
		lRet := .F.
	EndIf

Return lRet

/*/{Protheus.doc} ZB6CalcHrs
	Calcula as horas totais da ZB6,
	chamado à cada alteração de horas
	ou dias (gatilho)

	@type user function

	@author igor.seberino

	@since 03/11/2026

	@return numeric, Total de horas da atividade em decimal
/*/
User Function ZB6CalcHrs() as numeric

	Local nDoc   := FwFldGet("ZB6_HDOCNM") as numeric
	Local nDev   := FwFldGet("ZB6_HDEVNM") as numeric
	Local nAna   := FwFldGet("ZB6_HANANM") as numeric
	Local nVal   := FwFldGet("ZB6_HVALNM") as numeric
	Local nTotal := nDoc + nDev + nAna + nVal as numeric

Return nTotal

/*/{Protheus.doc} CalcHrsRows
	Calcula as horas totais dos elementos
	filhos e armazena no elemento pai

	@type user function

	@author igor.seberino

	@since 03/11/2026

	@param cModelCount, character, Submodelo filho somado (ex.: ZB6DETAIL)
	@param cFieldCount, character, Campo somado no filho
	@param cModel, character, Submodelo pai que recebe o total
	@param cField, character, Campo do pai que recebe o total

	@return logical, sempre .T.
/*/
User Function CalcHrsRows( cModelCount as character, cFieldCount as character, cModel as character, cField as character ) as logical

	Local oModel := FWModelActive() as object
	Local oGrid  := oModel:GetModel(cModelCount) as object
	Local nTotal as numeric
	Local nI     as numeric

	// Percorre cada item filho do grid
	For nI := 1 to oGrid:Length()

		If !oGrid:IsDeleted(nI)

			// Soma o total de horas
			nTotal := nTotal + oGrid:GetValue(cFieldCount, nI)

		EndIf

	Next nI

	oModel:GetModel(cModel):SetValue(cField, nTotal)

Return .T.

/*/{Protheus.doc} RemoveFields
	Fields removidos da view, separados
	por organização

	@type static function

	@author igor.seberino

	@since 03/11/2026

	@param oStruZB4, object, Estrutura da view da ZB4
	@param oStruZB5, object, Estrutura da view da ZB5
	@param oStruZB6, object, Estrutura da view da ZB6
	@param oStruZB7, object, Estrutura da view da ZB7

	@return logical, sempre .T.
/*/
Static Function RemoveFields( oStruZB4 as object, oStruZB5 as object, oStruZB6 as object, oStruZB7 as object ) as logical

	// ZB4
	oStruZB4:RemoveField("ZB4_HRDNUM")
	oStruZB4:RemoveField("ZB4_TTHRNM")

	// ZB5
	oStruZB5:RemoveField("ZB5_COD")
	oStruZB5:RemoveField("ZB5_REV")
	oStruZB5:RemoveField("ZB5_TTHRNM")

	// ZB6
	oStruZB6:RemoveField("ZB6_COD")
	oStruZB6:RemoveField("ZB6_REV")
	oStruZB6:RemoveField("ZB6_ITEM")
	oStruZB6:RemoveField("ZB6_TTHRNM")
	oStruZB6:RemoveField("ZB6_HDOCNM")
	oStruZB6:RemoveField("ZB6_HDEVNM")
	oStruZB6:RemoveField("ZB6_HANANM")
	oStruZB6:RemoveField("ZB6_HVALNM")

	// ZB7
	oStruZB7:RemoveField("ZB7_COD")
	oStruZB7:RemoveField("ZB7_REV")

Return .T.

/*/{Protheus.doc} VldActivate
	Bloqueia alteração e exclusão de orçamento
	que não está em rascunho (SetVldActive)

	@type static function

	@author igor.seberino

	@since 05/11/2026

	@param oModel, object, Modelo ZORCA04M

	@return logical, .T. = pode ativar
/*/
Static Function VldActivate( oModel as object ) as logical

	Local lRet       := .T. as logical
	Local nOperation := oModel:GetOperation() as numeric

	If ( nOperation == MODEL_OPERATION_UPDATE .Or. nOperation == MODEL_OPERATION_DELETE ) .And. ZB4->ZB4_STATUS != STATUS_RASCUNHO

		oModel:SetErrorMessage( "ZB4MASTER", "ZB4_STATUS", "ZB4MASTER", "ZB4_STATUS", "ERRO", ;
			"Orçamento enviado não pode ser alterado nem excluído.", ;
			"Utilize visualizar ou aguarde retorno" )
		lRet := .F.

	EndIf

Return lRet

/*/{Protheus.doc} RelationSet
	Relacionamentos do modelo: ZB4 -> ZB5 -> ZB6 e ZB4 -> ZB7

	@type static function

	@author igor.seberino

	@since 05/11/2026

	@param oModel, object, Modelo ZORCA04M
/*/
Static Function RelationSet( oModel as object )

	// Define relação entre ZB4 e ZB5
	oModel:SetRelation("ZB5DETAIL", { ;
		{"ZB5_FILIAL", "xFilial('ZB5')"}, ;
		{"ZB5_COD"   , "ZB4_COD"}, ;
		{"ZB5_REV"   , "ZB4_REV"}  ;
		}, ZB5->(IndexKey(1)))

	// Define relação entre ZB5 e ZB6
	oModel:SetRelation("ZB6DETAIL", { ;
		{"ZB6_FILIAL" , "xFilial('ZB6')"}, ;
		{"ZB6_COD"    , "ZB4_COD"}, ;
		{"ZB6_REV"    , "ZB4_REV"},  ;
		{"ZB6_ITEM"   , "ZB5_ITEM"}  ;
		}, ZB6->(IndexKey(1)))

	// Define relação entre ZB7 e ZB4
	oModel:SetRelation("ZB7DETAIL", { ;
		{"ZB7_FILIAL" , "xFilial('ZB7')"}, ;
		{"ZB7_COD"    , "ZB4_COD"}, ;
		{"ZB7_REV"    , "ZB4_REV"}  ;
		}, ZB7->(IndexKey(1)))

Return

/*/{Protheus.doc} HideHist
	Oculta a pasta de histórico na inclusão (e na cópia,
	que também é inclusão)

	@type static function

	@author igor.seberino

	@since 05/11/2026

	@param oView, object, View ativa
/*/
Static Function HideHist( oView as object )

	Local oModel := oView:GetModel() as object

	// Cópia é uma operação de inclusão tbm
	If oModel:GetOperation() == MODEL_OPERATION_INSERT
		oView:HideFolder( 'FOLDER', 'Histórico de Aprovação', 2 )
	EndIf

Return

/*/{Protheus.doc} ZB4Activate
	Na cópia, limpa os campos de controle do orçamento
	(revisão, status, ticket, task e dados de aprovação)

	@type static function

	@author igor.seberino

	@since 05/11/2026

	@param oModel, object, Modelo ZORCA04M

	@return logical, sempre .T.
/*/
Static Function ZB4Activate( oModel as object ) as logical

	Local oModelZB4 := oModel:GetModel( "ZB4MASTER" ) as object

	If oModel:IsCopy()

		oModelZB4:LoadValue( "ZB4_REV"   , "01" )
		oModelZB4:LoadValue( "ZB4_STATUS", STATUS_RASCUNHO )
		oModelZB4:LoadValue( "ZB4_TICKET", "" )
		oModelZB4:LoadValue( "ZB4_TASK"  , "" )
		oModelZB4:LoadValue( "ZB4_USRAPR", "" )
		oModelZB4:LoadValue( "ZB4_DTAPR" , CToD("") )
		oModelZB4:LoadValue( "ZB4_HRAPR" , "" )
		oModelZB4:LoadValue( "ZB4_USRINC", RetCodUsr() )

	EndIf

Return .T.

/*/{Protheus.doc} ModelCommit
	Commit do modelo: descarta as atividades com total
	de horas zerado antes de gravar

	@type static function

	@author igor.seberino

	@since 06/11/2026

	@param oModel, object, Modelo ZORCA04M

	@return logical, .T. se gravou
/*/
Static Function ModelCommit( oModel as object ) as logical

	Local oModelZB5 := oModel:GetModel("ZB5DETAIL") as object
	Local oModelZB6 := oModel:GetModel("ZB6DETAIL") as object
	Local n1        as numeric
	Local n2        as numeric
	Local nValue    as numeric
	Local lRet      := .T. as logical
	Local aSaveRows := FWSaveRows() as array // Grava a linha que estava posicionada

	For n1 := 1 to oModelZB5:Length()

		If !oModelZB5:IsDeleted(n1)

			oModelZB5:GoLine(n1)

			// Percorre cada atividade do item
			For n2 := 1 to oModelZB6:Length()

				If !oModelZB6:IsDeleted(n2)

					oModelZB6:GoLine(n2)
					nValue := oModelZB6:GetValue("ZB6_TTHRNM")

					If nValue == 0
						oModelZB6:DeleteLine()
					EndIf
				EndIf

			Next n2

		EndIf

	Next n1

	FWRestRows( aSaveRows ) // Restaura a linha que estava posicionada

	If !FWFormCommit( oModel )
		Help( , , "ZORCA04", , "Ocorreu um erro ao gravar o orçamento.", 1, 0 )
		lRet := .F.
	EndIf

Return lRet

/*/{Protheus.doc} AtivSimilares
	Botão "Atividades Similares": abre a consulta histórica
	(ZORCA07) filtrada pela definição do item posicionado

	@type static function

	@author igor.seberino

	@since 18/11/2026

	@param oView, object, View ativa
/*/
Static Function AtivSimilares( oView as object )

	Local oModel := oView:GetModel():GetModel( "ZB5DETAIL" ) as object
	Local cDef   := oModel:GetValue( "ZB5_DEFIN" ) as character

	custom.orc.consulta.historico.U_ZORCA07( cDef )

Return

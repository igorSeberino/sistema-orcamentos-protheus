#include "totvs.ch"
#include "tlpp-core.th"
#include "fwmvcdef.ch"

namespace custom.orc.orcamento.manutencao

using namespace custom.orc.utils

#define NAMESPACE "custom.orc.orcamento.manutencao"
#define UTILS "custom.orc.utils"
#define ZORCA05 "custom.orc.orcamento.aprovacao"

#define STATUS_RASCUNHO  "1"
#define STATUS_ENVIADO   "2"
#define STATUS_APROVADO  "3"
#define STATUS_REPROVADO "4"

#define ACAO_ENVIADO     "1"
#define ACAO_APROVADO    "2"
#define ACAO_REPROVADO   "3"
#define ACAO_ESTORNADO   "4"

/*/{Protheus.doc} ZORCA04
	Orçamentos (browse e manutenção) (ZB4) - tela browse

	@type function

	@author igor.seberino
	
	@since 25/10/2026
/*/
User Function ZORCA04()

    Local oBrowse := FWMarkBrowse():New()

    oBrowse:SetAlias("ZB4")
    oBrowse:SetDescription("Orçamentos (browse e manutenção)")

    // oBrowse:AddLegend(/* Campo = Valor */,/* Cor */,/* Legenda */)
	oBrowse:AddLegend("ZB4_STATUS = '1'", "WHITE", "Rascunho")
	oBrowse:AddLegend("ZB4_STATUS = '2'", "YELLOW", "Enviado")
	oBrowse:AddLegend("ZB4_STATUS = '3'", "GREEN", "Aprovado")
	oBrowse:AddLegend("ZB4_STATUS = '4'", "RED", "Reprovado")


    oBrowse:Activate()

Return

/*/{Protheus.doc} ModelDef
	Regras de negocio e estrutura de dados do Orçamentos (browse e manutenção) (ZB4)

	@type user function

	@author igor.seberino

	@since 25/10/2026

	@return object, o model MVC (MPFormModel)
/*/
User Function ModelDef()

    Local oModel := MPFormModel():New("ZORCA04M")
    Local oStruZB4 := FWFormStruct(1, "ZB4")
	Local oStruZB5 := FWFormStruct(1, "ZB5")
	Local oStruZB6 := FWFormStruct(1, "ZB6")
	Local oStruZB7 := FWFormStruct(1, "ZB7")

	// Seta os triggers do model
	U_TriggerSet( oStruZB4, oStruZB5, oStruZB6 )

    oModel:AddFields("ZB4MASTER", /*cOwner*/, oStruZB4)
	oModel:AddGrid("ZB5DETAIL", "ZB4MASTER", oStruZB5)
	oModel:AddGrid("ZB6DETAIL", "ZB5DETAIL", oStruZB6)
	oModel:AddGrid("ZB7DETAIL", "ZB4MASTER", oStruZB7)
    oModel:SetDescription('Modelo de Orçamentos')

	// Seta os relacionamentos do model
	U_RelationSet( @oModel )

    oModel:GetModel('ZB4MASTER'):SetDescription('Modelo de Orçamentos')
	oModel:GetModel("ZB5DETAIL"):SetUniqueLine( { "ZB5_ITEM" } )
	oModel:GetModel("ZB6DETAIL"):SetUniqueLine( { "ZB6_SUB" } )

	// Define o preenchimento do modelo como opcional
	oModel:GetModel("ZB6DETAIL"):SetOptional(.T.)
	oModel:GetModel("ZB7DETAIL"):SetOptional(.T.)

	// Apenas leitura
	oModel:GetModel("ZB7DETAIL"):SetOnlyQuery(.T.)
	oModel:GetModel("ZB7DETAIL"):SetNoInsertLine(.T.)
	oModel:GetModel("ZB7DETAIL"):SetNoUpdateLine(.T.)
	oModel:GetModel("ZB7DETAIL"):SetNoDeleteLine(.T.)

	// Define chave primária da entidade Model
	oModel:SetPrimaryKey({ "ZB4_FILIAL", "ZB4_COD", "ZB4_REV" })

    oModel:SetActivate({ |oModel| U_ZB4Activate( @oModel ) })

	// Condiciona a edição do orçamento ao status de rascunho
	oModel:SetVldActive( { |oModel| U_VldActivate( @oModel ) } )

	oModel:SetCommit({|oModel| U_ModelCommit(oModel)})

Return oModel

/*/{Protheus.doc} ViewDef
	Layout visual do Orçamentos (browse e manutenção) (ZB4)

	@type user function

	@author igor.seberino

	@since 25/10/2026

	@return object, a view MVC (FWFormView)
/*/
User Function ViewDef()

    Local oModel := FWLoadModel(NAMESPACE + ".ZORCA04")
    Local oStruZB4 := FWFormStruct(2, "ZB4")
	Local oStruZB5 := FWFormStruct(2, "ZB5")
	Local oStruZB6 := FWFormStruct(2, "ZB6")
	Local oStruZB7 := FWFormStruct(2, "ZB7")
    Local oView := FWFormView():New()

	// Esconde campos do usuário (controle interno)
	U_RemoveFields( oStruZB4, oStruZB5, oStruZB6, oStruZB7 )

    oView:SetModel( oModel )
    oView:AddField( 'VIEW_ZB4', oStruZB4, 'ZB4MASTER' )
	oView:AddGrid(  'VIEW_ZB5', oStruZB5, 'ZB5DETAIL' )
	oView:AddGrid(  'VIEW_ZB6', oStruZB6, 'ZB6DETAIL' )
	oView:AddGrid(  'VIEW_ZB7', oStruZB7, 'ZB7DETAIL' )

    oView:CreateHorizontalBox( 'TELA', 60 )
	oView:CreateHorizontalBox( 'PASTAS', 40 )

	oView:CreateFolder( 'FOLDER', 'PASTAS' )
	oView:AddSheet( 'FOLDER', 'ATIVIDADES', 'Atividades' )
	oView:AddSheet( 'FOLDER', 'HISTORICO', 'Histórico de Aprovação' )

	oView:CreateHorizontalBox('BOX_ZB5', 50, , ,  'FOLDER', 'ATIVIDADES')
	oView:CreateHorizontalBox('BOX_ZB6', 50, , ,  'FOLDER', 'ATIVIDADES')
	oView:CreateHorizontalBox('BOX_ZB7', 100, , , 'FOLDER', 'HISTORICO')

    oView:SetOwnerView( 'VIEW_ZB4', 'TELA' )
	oView:SetOwnerView( 'VIEW_ZB5', 'BOX_ZB5' )
	oView:SetOwnerView( 'VIEW_ZB6', 'BOX_ZB6' )
	oView:SetOwnerView( 'VIEW_ZB7', 'BOX_ZB7' )

	// Define o código incrementais para ZB5 e ZB6
	oView:AddIncrementField("VIEW_ZB5", "ZB5_ITEM")
	oView:AddIncrementField("VIEW_ZB6", "ZB6_SUB")

	// Oculta o histórico na inclusão
	oView:SetAfterViewActivate( { |oView| U_HideHist( oView ) } )

Return oView

/*/{Protheus.doc} MenuDef
	Acoes disponiveis no Orçamentos (browse e manutenção) (ZB4)

	@type user function

	@author igor.seberino

	@since 25/10/2026

	@return array, itens de menu
/*/
User Function MenuDef()

    Local aRotina := {}
    //Define a chamada das actions do menu 
    Local cActionString := FormatStr("VIEWDEF.%c.ZORCA04", NAMESPACE)

    ADD OPTION aRotina Title 'Visualizar' Action cActionString OPERATION 2 ACCESS 0
	ADD OPTION aRotina Title 'Incluir' Action cActionString OPERATION 3 ACCESS 0
	ADD OPTION aRotina Title 'Alterar' Action cActionString OPERATION 4 ACCESS 0
	ADD OPTION aRotina Title 'Excluir' Action cActionString OPERATION 5 ACCESS 0
	ADD OPTION aRotina Title 'Imprimir' Action cActionString OPERATION 8 ACCESS 0
	ADD OPTION aRotina Title 'Copiar' Action cActionString OPERATION 9 ACCESS 0
	ADD OPTION aRotina Title 'Enviar Rascunho' Action ZORCA05 + ".U_ZORCA05( 'ENV' )" OPERATION 5 ACCESS 0
	ADD OPTION aRotina Title 'Novo Rascunho' Action ZORCA05 + ".U_ZORCA05( 'NOV' )" OPERATION 5 ACCESS 0

	If U_VldAprovador()
		ADD OPTION aRotina Title 'Aprovação' Action ZORCA05 + ".U_ZORCA05( 'APR' )" OPERATION 5 ACCESS 0
		ADD OPTION aRotina Title 'Estornar' Action ZORCA05 + ".U_ZORCA05( 'EST' )" OPERATION 5 ACCESS 0
	EndIf

Return aRotina

/*/{Protheus.doc} VldData
	Valida se a data de validade é posterior à data de criação

	@type user function

	@author igor.seberino

	@since 26/10/2026

	@return logical
/*/
User Function VldData()

	Local lRet := .T.
	Local dDataInit := M->ZB4_DATA
	Local dDataValid := M->ZB4_VALID

	If dDataInit > dDataValid
		Help(, , "HELP", "", "Validade não pode ser anterior à data de abertura do orçamento", 1, 0)
		lRet := .F.
	EndIf

Return lRet

/*/{Protheus.doc} TriggerSet
	Separação da criação dos triggers da 
	ModelDef(). Apenas por organização

	@type user function

	@author igor.seberino

	@since 30/10/2026

	@return Nil
/*/
User Function TriggerSet( oStruZB4 as object, oStruZB5 as object, oStruZB6 as object )

	Local aTriggersZB4 := {}
	Local aTriggersZB5 := {}
	Local aTriggersZB6 := {}
	Local nI as numeric

	// Monta triggers de ZB4
	aAdd( aTriggersZB4, FwStruTrigger( "ZB4_LOJA", "ZB4_NOMCLI", 'Posicione("SA1", 1, xFilial("SA1") + M->ZB4_CLIENT + M->ZB4_LOJA, "A1_NOME")', .F., "", 0,,, "01" ) )
	aAdd( aTriggersZB4, FwStruTrigger( "ZB4_HRDIA", "ZB4_HRDNUM", UTILS + '.U_HoursToNum(M->ZB4_HRDIA)', .F., "", 0,,, "01" ) )
	aAdd( aTriggersZB4, FwStruTrigger( "ZB4_TOTHR", "ZB4_TTHRNM", UTILS + '.U_HoursToNum(M->ZB4_TOTHR)', .F., "", 0,,, "01" ) )

	// Monta triggers de ZB5
	aAdd( aTriggersZB5, FwStruTrigger( "ZB5_DEFIN", "ZB5_DESDEF", 'Posicione("ZB2", 1, xFilial("ZB2") + M->ZB5_DEFIN, "ZB2_DESC")', .F., "", 0,,, "01" ) )
	aAdd( aTriggersZB5, FwStruTrigger( "ZB5_AREA", "ZB5_DESARE", 'Posicione("ZB1", 1, xFilial("ZB1") + M->ZB5_AREA, "ZB1_DESC")', .F., "", 0,,, "01" ) )

	// Triggers de ZB6 (Hora char p/ hora num)
	aAdd( aTriggersZB6, FWStruTrigger( "ZB6_HDOC", "ZB6_HDOCNM", UTILS + ".U_HoursToNum(M->ZB6_HDOC)", .F., "", 0,,, "01" ) )
	aAdd( aTriggersZB6, FWStruTrigger( "ZB6_HDEV", "ZB6_HDEVNM", UTILS + ".U_HoursToNum(M->ZB6_HDEV)", .F., "", 0,,, "01" ) )
	aAdd( aTriggersZB6, FWStruTrigger( "ZB6_HANA", "ZB6_HANANM", UTILS + ".U_HoursToNum(M->ZB6_HANA)", .F., "", 0,,, "01" ) )
	aAdd( aTriggersZB6, FWStruTrigger( "ZB6_HVAL", "ZB6_HVALNM", UTILS + ".U_HoursToNum(M->ZB6_HVAL)", .F., "", 0,,, "01" ) )

	// ZB6 Cálculo horas totais
	aAdd( aTriggersZB6, FWStruTrigger( "ZB6_HDOCNM", "ZB6_TTHRNM", NAMESPACE + ".U_ZB6CalcHrs()", .F., "", 0,,, "01" ) )
	aAdd( aTriggersZB6, FWStruTrigger( "ZB6_HDEVNM", "ZB6_TTHRNM", NAMESPACE + ".U_ZB6CalcHrs()", .F., "", 0,,, "01" ) )
	aAdd( aTriggersZB6, FWStruTrigger( "ZB6_HANANM", "ZB6_TTHRNM", NAMESPACE + ".U_ZB6CalcHrs()", .F., "", 0,,, "01" ) )
	aAdd( aTriggersZB6, FWStruTrigger( "ZB6_HVALNM", "ZB6_TTHRNM", NAMESPACE + ".U_ZB6CalcHrs()", .F., "", 0,,, "01" ) )


	// Adiciona triggers à ZB4
	For nI := 1 to Len(aTriggersZB4)
		oStruZB4:AddTrigger( aTriggersZB4[nI][1], aTriggersZB4[nI][2], aTriggersZB4[nI][3], aTriggersZB4[nI][4] )
	Next nI

	// Adiciona triggers à ZB5
	For nI := 1 to Len(aTriggersZB5)
		oStruZB5:AddTrigger( aTriggersZB5[nI][1], aTriggersZB5[nI][2], aTriggersZB5[nI][3], aTriggersZB5[nI][4] )
	Next nI

	// Adiciona triggers à ZB6
	For nI := 1 to Len(aTriggersZB6)
		oStruZB6:AddTrigger( aTriggersZB6[nI][1], aTriggersZB6[nI][2], aTriggersZB6[nI][3], aTriggersZB6[nI][4] )
	Next nI

Return

/*/{Protheus.doc} VldHrs
	Valida o campo horas e seta o campo
	dias já convertido

	@type user function

	@author igor.seberino

	@since 03/11/2026

	@return logical
/*/
User Function VldHrs( cFieldDays )

	Local oModel  := FWModelActive()
	Local oModelZB6 := oModel:GetModel("ZB6DETAIL")
    Local nDias  as numeric
    Local nHoras as numeric

	// Captura as horas do campo
	// ReadVar() retorna o nome do campo
    nHoras := &(ReadVar())

    If nHoras < 0
        Help( , , "	HELP", , "Horas não podem ser negativas.", 1, 0 )
        Return .F.
    EndIf

	// Converte horas em dias
    nDias := nHoras / FwFldGet("ZB4_HRDNUM")

	// Seta na var de dias
    oModelZB6:LoadValue( cFieldDays, nDias )
	
Return .T.

/*/{Protheus.doc} VldDias
	Valida o campo dias e seta o campo
	horas já convertido

	@type user function

	@author igor.seberino

	@since 03/11/2026

	@return logical
/*/
User Function VldDias( cFieldHrs as character ) as logical

    Local oModel  := FWModelActive()
	Local oModelZB6 := oModel:GetModel("ZB6DETAIL")
	Local nDias as numeric
    Local cHoras as numeric

	// Captura os dias do campo
	// ReadVar() retorna o nome do campo
	nDias := &(ReadVar())

    If nDias < 0
        Help( , , "	HELP", , "Dias não podem ser negativos.", 1, 0 )
        Return .F.
    EndIf

	// Converte dias em horas
    cHoras := U_NumToHours(nDias * FwFldGet("ZB4_HRDNUM"), 8)

	// Seta o valor de horas
    oModelZB6:SetValue( cFieldHrs, cHoras )

Return .T.

/*/{Protheus.doc} ZB6CalcHrs
	Calcula as horas totais da ZB6,
	chamado à cada alteração de horas
	ou dias

	@type user function

	@author igor.seberino

	@since 03/11/2026

	@return numeric
/*/
User Function ZB6CalcHrs()

	Local nDoc := FwFldGet("ZB6_HDOCNM")
	Local nDev := FwFldGet("ZB6_HDEVNM")
	Local nAna := FwFldGet("ZB6_HANANM")
	Local nVal := FwFldGet("ZB6_HVALNM")

	Local nTotal := nDoc + nDev + nAna + nVal

Return nTotal                                       

/*/{Protheus.doc} CalcHrsRows
	Calcula as horas totais dos elementos
	filhos e armazena no elemento pai

	@type user function

	@author igor.seberino

	@since 03/11/2026

	@return logical
/*/
User Function CalcHrsRows( cModelCount, cFieldCount, cModel, cField )

	Local oModel := FWModelActive()
	Local oGrid := oModel:GetModel(cModelCount)

	Local nTotal as numeric
	Local nI as numeric

	// Percorre cada item filho do grid
	For nI := 1 to oGrid:Length()

		If !oGrid:IsDeleted(nI)

			// Soma o total de horas
			nTotal := nTotal + oGrid:GetValue(cFieldCount, nI)

		EndIf

	Next nI

	oModel:GetModel(cModel):SetValue(cField, nTotal)

Return .T.

/*/{Protheus.doc} RemoveFields
	Fields removidos da view, separados
	por organização

	@type user function

	@author igor.seberino

	@since 03/11/2026
/*/
User Function RemoveFields( oStruZB4, oStruZB5, oStruZB6, oStruZB7 )

	// ZB4
	oStruZB4:RemoveField("ZB4_HRDNUM")
	oStruZB4:RemoveField("ZB4_TTHRNM")

	// ZB5
	oStruZB5:RemoveField("ZB5_COD")
	oStruZB5:RemoveField("ZB5_REV")
	oStruZB5:RemoveField("ZB5_TTHRNM")

	// ZB6
	oStruZB6:RemoveField("ZB6_COD")
	oStruZB6:RemoveField("ZB6_REV")
	oStruZB6:RemoveField("ZB6_ITEM")
	oStruZB6:RemoveField("ZB6_TTHRNM")
	oStruZB6:RemoveField("ZB6_HDOCNM")
	oStruZB6:RemoveField("ZB6_HDEVNM")
	oStruZB6:RemoveField("ZB6_HANANM")
	oStruZB6:RemoveField("ZB6_HVALNM")

	// ZB7
	oStruZB7:RemoveField("ZB7_COD")
	oStruZB7:RemoveField("ZB7_REV")

Return .T.                                                                                                    

User Function VldActivate( oModel as object )

	Local lRet := .T.
	local nOperation := oModel:GetOperation()

	If ( nOperation == MODEL_OPERATION_UPDATE .Or. nOperation == MODEL_OPERATION_DELETE ) .And. ZB4->ZB4_STATUS != "1"
	
		oModel:SetErrorMessage( "ZB4MASTER", "ZB4_STATUS", "ZB4MASTER", "ZB4_STATUS", "ERRO", ;
        "Orçamento enviado não pode ser alterado nem excluído.", ;
        "Utilize visualizar ou aguarde retorno" )
		lRet := .F.
	
	EndIf

Return lRet

User Function RelationSet( oModel )

	// Define relação entre ZB4 e ZB5
	oModel:SetRelation("ZB5DETAIL", { ;
        {"ZB5_FILIAL", "xFilial('ZB5')"}, ;
        {"ZB5_COD"   , "ZB4_COD"}, ;
        {"ZB5_REV"   , "ZB4_REV"}  ;
    }, ZB5->(IndexKey(1)))

	// Define relação entre ZB5 e ZB6
	oModel:SetRelation("ZB6DETAIL", { ;
        {"ZB6_FILIAL" , "xFilial('ZB6')"}, ;
        {"ZB6_COD"    , "ZB4_COD"}, ;
        {"ZB6_REV"    , "ZB4_REV"},  ;
		{"ZB6_ITEM"   , "ZB5_ITEM"}  ;
    }, ZB6->(IndexKey(1)))
	
	// Define relação entre ZB7 e ZB4
	oModel:SetRelation("ZB7DETAIL", { ;
        {"ZB7_FILIAL" , "xFilial('ZB7')"}, ;
        {"ZB7_COD"    , "ZB4_COD"}, ;
        {"ZB7_REV"    , "ZB4_REV"}  ;
    }, ZB7->(IndexKey(1)))

Return

User Function HideHist( oView )

	Local oModel := oView:GetModel()

	// Cópia é uma operação de inclusão tbm
	If oModel:GetOperation() == MODEL_OPERATION_INSERT
		oView:HideFolder( 'FOLDER', 'Histórico de Aprovação', 2 )
	EndIf

Return

User Function ZB4Activate( oModel )

	Local oModelZB4 := oModel:GetModel( "ZB4MASTER" )

	If oModel:IsCopy()

		oModelZB4:LoadValue( "ZB4_REV"   , "01" )
		oModelZB4:LoadValue( "ZB4_STATUS", STATUS_RASCUNHO )
		oModelZB4:LoadValue( "ZB4_TICKET", "" )
		oModelZB4:LoadValue( "ZB4_TASK"  , "" )
		oModelZB4:LoadValue( "ZB4_USRAPR", "" )
		oModelZB4:LoadValue( "ZB4_DTAPR" , CToD("") )
		oModelZB4:LoadValue( "ZB4_HRAPR" , "" )
		oModelZB4:LoadValue( "ZB4_USRINC", RetCodUsr() )

	EndIf

Return .T.

User Function ModelCommit( oModel )

	Local oModelZB5 := oModel:GetModel("ZB5DETAIL")
	Local oModelZB6 := oModel:GetModel("ZB6DETAIL")
	Local n1 as numeric
	Local n2 as numeric
	Local nValue as numeric

	For n1 := 1 to oModelZB5:Length()

		If !oModelZB5:IsDeleted(n1)

            oModelZB5:GoLine(n1)

            // Percorre cada atividade do item
			For n2 := 1 to oModelZB6:Length()

				If !oModelZB6:IsDeleted(n2) 

					oModelZB6:GoLine(n2)
					nValue := oModelZB6:GetValue("ZB6_TTHRNM")

					If nValue == 0
						oModelZB6:DeleteLine()
					EndIf
				EndIf

			Next n2

		EndIf

	Next n1

	FWFormCommit( oModel )

Return .T.

User Function VldAprovador()

	Local lRet := .F.
    Local cQuery := U_QuerySet( "ZB3", {"ZB3_USER"}, {{"ZB3.ZB3_USER = ", RetCodUsr()}} )
    Local cAliasQry := MPSysOpenQuery(cQuery)

    If !(cAliasQry)->(EoF())
        lRet := .T.
    EndIf

Return lRet
